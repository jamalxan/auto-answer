# Caddy gets TLS certificates from Let's Encrypt automatically on first
# request — no certbot, no renewal cron. Requires socialauto.uz's DNS A
# record to point at this server and ports 80/443 to be reachable.

socialauto.uz, www.socialauto.uz {
	encode zstd gzip

	# Static assets Next.js content-hashes — safe to cache hard.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
