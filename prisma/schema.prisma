// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
  telegramUsers     TelegramUser[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  // Platform-admin kill switch (lib/admin), not a per-workspace setting the
  // owner controls. Suspended workspaces keep their data but stop sending —
  // enforced in reserveWorkspaceDMSend rather than scattered across callers.
  isSuspended Boolean   @default(false)
  suspendedAt DateTime?

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  integrations       Integration[]
  leads              Lead[]
  conversations      Conversation[]
  assistantProfiles  AssistantProfile[]
  telegramUsers      TelegramUser[]
  onboardingSessions OnboardingSession[]
  knowledgeGaps      KnowledgeGap[]
  llmUsage           LlmUsage[]
  assistantEvents    AssistantEvent[]
  telegramLinkCodes  TelegramLinkCode[]

  // Instagram Trigger Engine (dev)
  instagramEvents      InstagramEvent[]
  triggerCampaigns     TriggerCampaign[]
  triggerExecutions    TriggerExecution[]
  instagramContacts    InstagramContact[]
  triggerConversations TriggerConversation[]
  triggerFollowUpRuns  TriggerFollowUpRun[]
  triggerBacktrackRuns TriggerBacktrackRun[]

  // JavobAI (developer area, ETAP 4)
  javobAiAccounts   JavobAiAccount[]
  aiScoringConfigs  AiScoringConfig[]
  aiHandoffRules    AiHandoffRule[]
  aiShadowTurns     AiShadowTurn[]
  aiBudget          AiBudget?

  // Monthly AI-conversation quota (TZ section 13). null = default from
  // lib/assistant/limits. The counter resets with usagePeriodStart.
  aiConversationsLimit      Int?
  aiConversationsThisPeriod Int @default(0)
  // Set when the LLM provider keeps failing: the assistant answers from
  // templates only until this moment.
  assistantTemplateOnlyUntil DateTime?

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  // Real token health, verified against Meta every few hours
  // (lib/meta/token-health). "Connected" in the UI means tokenStatus = ACTIVE,
  // not merely "a row exists".
  tokenStatus       TokenStatus @default(ACTIVE)
  tokenCheckedAt    DateTime?
  tokenLastError    String?
  tokenBrokenAt     DateTime?
  tokenAlertedAt    DateTime?
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  conversations     Conversation[]
  leads             Lead[]
  assistantProfiles AssistantProfile[]

  // Instagram Trigger Engine (dev)
  instagramEvents      InstagramEvent[]
  triggerCampaigns     TriggerCampaign[]
  instagramContacts    InstagramContact[]
  triggerConversations TriggerConversation[]
  javobAiAccount       JavobAiAccount?

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  // Hand people who reply to this campaign's DM over to the lead assistant.
  handoffToAssistant Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
  // Comment 2.0 / backtrack look up "already answered privately" by comment.
  @@index([commentId])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
  SKIPPED_WORKSPACE_SUSPENDED
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

// Public pricing shown on the landing page. There's no billing integration
// yet (see lib/billing/usage.ts) — these rows are marketing copy the
// platform admin edits from /admin, not enforced plan limits. `content`
// holds the localized copy: { en: { name, description, features: string[] },
// ru: {...}, uz: {...} } — see lib/pricing.ts's PricingPlanContent type.
model PricingPlan {
  id            String   @id @default(cuid())
  slug          String   @unique
  priceAmount   Int      @default(0)
  priceCurrency String   @default("$")
  priceSuffix   String   @default("/mo")
  content       Json
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
}

// Platform-admin login (/admin) — deliberately separate from the customer
// User/NextAuth system: the platform admin isn't a workspace member and
// shouldn't need a magic-link email to reach a cross-workspace panel.
// Lazily seeded on first read (see lib/admin/auth.ts), same pattern as
// PricingPlan's defaults.
model AdminAccount {
  id                  String    @id @default(cuid())
  username            String    @unique
  passwordHash        String
  email               String
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Lead assistant, leads and CRM integrations ────────────────────────────────

enum TokenStatus {
  ACTIVE
  BROKEN
}

enum IntegrationType {
  TELEGRAM
  AMOCRM
  BITRIX24
}

enum IntegrationStatus {
  ACTIVE
  BROKEN
  DISABLED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

enum LeadStatus {
  NEW
  SENT
  PARTIAL
  FAILED
}

enum LeadSource {
  CAMPAIGN
  INBOUND_DM
}

enum AssistantState {
  NEW
  NEED
  CONTACT
  CAPTURED
  FALLBACK
  HANDED_OFF
}

enum MessageAuthor {
  CUSTOMER
  ASSISTANT
  OPERATOR
  SYSTEM
}

enum PricePolicy {
  NEVER
  FROM_ONLY
  EXACT
}

enum AssistantTone {
  FRIENDLY
  FORMAL
}

enum ProfileSource {
  PANEL
  TELEGRAM
}

enum OnboardingStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum UploadKind {
  VOICE
  PHOTO
  XLSX
  CSV
  PDF
}

enum GapStatus {
  OPEN
  ANSWERED
  IGNORED
}

enum FaqSource {
  OWNER
  KNOWLEDGE_GAP
}

model Integration {
  id                   String            @id @default(cuid())
  workspaceId          String
  type                 IntegrationType
  name                 String
  status               IntegrationStatus @default(ACTIVE)
  // AES-GCM, same mechanism as Instagram tokens (lib/meta/oauth encryptToken).
  // Holds a JSON string, e.g. { token } or { webhookUrl }.
  credentialsEncrypted String?
  config               Json              @default("{}")
  // Empty = deliver leads from every Instagram account of the workspace.
  igAccountFilter      String[]          @default([])
  tokenExpiresAt       DateTime?
  tokenWarnedAt        DateTime?
  lastCheckedAt        DateTime?
  lastError            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChats TelegramChat[]
  deliveries    LeadDelivery[]

  @@index([workspaceId, type])
}

model TelegramChat {
  id            String   @id @default(cuid())
  integrationId String
  chatId        String
  title         String?
  type          String   @default("private")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, chatId])
  @@index([chatId])
}

model TelegramLinkCode {
  code        String    @id
  workspaceId String
  // "link" connects a chat for lead delivery; "onboarding" starts the owner
  // Q&A (TZ 3A) and also pins the user + Instagram account.
  purpose     String    @default("link")
  userId      String?
  igAccountId String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model TelegramUser {
  id          String   @id @default(cuid())
  tgUserId    String   @unique
  userId      String
  workspaceId String
  language    String   @default("uz")
  linkedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Conversation {
  id                 String         @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  // Instagram-scoped id of the customer.
  igUserId           String
  igUsername         String?
  igName             String?

  assistantState      AssistantState @default(NEW)
  botMessageCount     Int            @default(0)
  phoneAskCount       Int            @default(0)
  // Consecutive spam/irrelevant intents.
  spamStreak          Int            @default(0)
  // Incremented when a chat restarts after 30 days of silence.
  leadCycle           Int            @default(0)
  // The bot stays silent until this moment after a human operator replied.
  operatorActiveUntil DateTime?
  // Manual "stop the bot" switch from the inbox.
  botPaused           Boolean        @default(false)
  // The campaign whose DM triggered the conversation (trigger A), if any.
  campaignId          String?
  source              LeadSource     @default(INBOUND_DM)
  // { name, phone_e164, product_interest, extra_field, language }
  collected           Json           @default("{}")
  lastCustomerMessageAt DateTime?
  lastBotMessageAt    DateTime?
  lastNotifiedAt      DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount      @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  messages         ConversationMessage[]
  leads            Lead[]

  // JavobAI (ETAP 4): v2-only state, 1:1.
  aiState   AiConversationState?
  aiHandoffs AiHandoff[]

  @@unique([instagramAccountId, igUserId])
  @@index([workspaceId, assistantState])
}

model ConversationMessage {
  id             String        @id @default(cuid())
  conversationId String
  // Instagram message id; unique per conversation so webhook retries are idempotent.
  mid            String?
  author         MessageAuthor
  text           String
  llmMeta        Json?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, mid])
  @@index([conversationId, createdAt])
}

model Lead {
  id                 String     @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  conversationId     String?
  igUserId           String
  igUsername         String?
  name               String?
  phoneE164          String?
  phoneRaw           String?
  productInterest    String?
  extraField         String?
  language           String?
  status             LeadStatus @default(NEW)
  source             LeadSource @default(INBOUND_DM)
  campaignId         String?
  campaignName       String?
  triggerKeyword     String?
  postUrl            String?
  summary            String?
  transcript         String?
  // Why the lead is special: "no_phone" | "complaint" | null
  flag               String?
  isTest             Boolean    @default(false)
  // conversationId:leadCycle - makes lead creation idempotent per conversation
  // while still allowing a fresh lead when the chat restarts after 30 days.
  idempotencyKey     String     @unique
  isRepeat           Boolean    @default(false)
  // Points at the first lead when this one is a repeat inquiry (TZ 7.4).
  repeatOfId         String?
  repeatCount        Int        @default(0)
  trackedLinkClicked Boolean    @default(false)
  contactedByUserId  String?
  contactedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  conversation     Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // JavobAI (ETAP 4): score, temperature and extra fields, 1:1.
  aiInsight        AiLeadInsight?
  deliveries       LeadDelivery[]

  @@index([conversationId])
  @@index([workspaceId, phoneE164, createdAt])
  @@index([workspaceId, createdAt])
}

model LeadDelivery {
  id            String         @id @default(cuid())
  leadId        String
  integrationId String
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  externalId    String?
  externalUrl   String?
  // "new" | "repeat" - repeat deliveries become CRM notes on the existing lead.
  kind          String         @default("new")
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([leadId, integrationId, kind])
  @@index([status, nextAttemptAt])
  @@index([integrationId, status])
}

model AssistantProfile {
  id                       String        @id @default(cuid())
  workspaceId              String
  // null = applies to every Instagram account of the workspace.
  instagramAccountId       String?
  enabled                  Boolean       @default(false)
  approvedAt               DateTime?
  companyName              String        @default("")
  description              String        @default("")
  pricePolicy              PricePolicy   @default(NEVER)
  tone                     AssistantTone @default(FRIENDLY)
  personaName              String?
  extraFieldLabel          String?
  finalMessageTemplate     String?
  handleCampaignReplies    Boolean       @default(true)
  handleInboundDm          Boolean       @default(false)
  operatorPauseHours       Int           @default(24)
  maxBotMessages           Int           @default(6)
  fallbackLeadWithoutPhone Boolean       @default(true)
  postHandoffReply         Boolean       @default(false)
  workingHours             Json?
  offHoursMessage          String?
  address                  String?
  branches                 Json?
  delivery                 String?
  paymentMethods           String[]      @default([])
  categories               Json          @default("[]")
  source                   ProfileSource @default(PANEL)
  languageDefault          String        @default("uz_latn")
  priceReminderEnabled     Boolean       @default(true)
  priceReminderSentAt      DateTime?
  // Learning from operators: style rules and example replies distilled from
  // how human managers answer, applied to the assistant's own replies.
  learningEnabled          Boolean       @default(false)
  learnedStyle             String?
  learnedExamples          Json          @default("[]")
  learnedAt                DateTime?
  learnedDialogues         Int           @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount?  @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  products         AssistantProduct[]
  faqs             AssistantFaq[]
  changes          ProfileChangeLog[]

  @@index([workspaceId])
}

model AssistantProduct {
  id             String   @id @default(cuid())
  profileId      String
  name           String
  note           String?
  price          Decimal? @db.Decimal(14, 2)
  priceIsFrom    Boolean  @default(false)
  currency       String   @default("UZS")
  unit           String?
  priceUpdatedAt DateTime @default(now())
  sort           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sort])
}

model AssistantFaq {
  id        String    @id @default(cuid())
  profileId String
  question  String
  answer    String
  source    FaqSource @default(OWNER)
  sort      Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sort])
}

model OnboardingSession {
  id             String           @id @default(cuid())
  workspaceId    String
  tgUserId       String
  igAccountId    String?
  step           Int              @default(0)
  answers        Json             @default("{}")
  status         OnboardingStatus @default(ACTIVE)
  language       String           @default("uz")
  // FSM scratch space (pending confirmation, edit pointer, ...).
  fsm            Json             @default("{}")
  reminderSentAt DateTime?
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  updatedAt      DateTime         @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploads   OnboardingUpload[]

  @@index([workspaceId, status])
  @@index([tgUserId, status])
}

model OnboardingUpload {
  id        String     @id @default(cuid())
  sessionId String
  kind      UploadKind
  tgFileId  String
  parsed    Json?
  confirmed Boolean    @default(false)
  createdAt DateTime   @default(now())

  session OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ProfileChangeLog {
  id          String        @id @default(cuid())
  profileId   String
  source      ProfileSource
  actorUserId String?
  field       String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime      @default(now())

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model KnowledgeGap {
  id                 String    @id @default(cuid())
  workspaceId        String
  questionNormalized String
  examples           Json      @default("[]")
  hits               Int       @default(1)
  status             GapStatus @default(OPEN)
  answer             String?
  answeredAt         DateTime?
  lastNotifiedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model LlmUsage {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String?
  kind           String   @default("reply")
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  latencyMs      Int      @default(0)
  ok             Boolean  @default(true)
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model AssistantEvent {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String?
  // blocked_reply | fallback | llm_error | template_mode | operator_takeover ...
  type           String
  payload        Json?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, createdAt])
}

// ─── Instagram Trigger Engine (DEV) ────────────────────────────────────────────
//
// A shared event pipeline: webhook → normalised InstagramEvent → trigger
// matching → TriggerExecution (the action). Kept apart from the comment→DM
// campaigns (Automation / DmLog) and the lead assistant (Conversation) until it
// is promoted out of dev mode — see lib/triggers/README.md.

enum InstagramEventType {
  STORY_REPLY
  STORY_MENTION
  DIRECT_MESSAGE
  LIVE_COMMENT
  // Reserved: not produced by the normaliser until the payload of a story
  // reaction is confirmed against real webhooks.
  STORY_REACTION
  COMMENT
  // Any reaction to a message (message_reactions). Stored in observation mode
  // only: whether story reactions arrive this way is not documented.
  MESSAGE_REACTION
}

enum InstagramEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  IGNORED
  RETRYING
  FAILED
}

enum TriggerStoryScope {
  ALL
  SPECIFIC
}

enum TriggerMatchMode {
  EVERY
  CONTAINS
  EXACT
}

enum TriggerResponseType {
  SEND_MESSAGE
}

enum TriggerExecutionStatus {
  PENDING
  // Set right before the Instagram call. Found again on a re-run it means the
  // process died mid-send, so the engine stops instead of risking a second DM.
  SENDING
  SENT
  RETRYING
  FAILED
  SKIPPED
}

enum TriggerMediaScope {
  ANY
  SPECIFIC
}

enum TriggerReplyMode {
  RANDOM
  SEQUENTIAL
  WEIGHTED
}

enum TriggerVariantKind {
  DM
  PUBLIC
}

enum TriggerVariantSource {
  MANUAL
  AI
}

enum TriggerQuickReplyAction {
  MESSAGE
  LEAD_CAPTURE
  HANDOFF
  // Hands the thread to JavobAI (ETAP 4); only honoured on a LIVE account,
  // otherwise behaves like HANDOFF.
  AI
}

enum TriggerFollowUpCondition {
  ALWAYS
  // Only if the person has not written anything since the trigger.
  NO_REPLY
  // Only if the person has not tapped the opening button.
  NO_CLICK
}

enum TriggerFollowUpStatus {
  SCHEDULED
  SENDING
  SENT
  SKIPPED
  CANCELLED
  FAILED
}

enum TriggerSideStatus {
  SENT
  FAILED
}

enum TriggerBacktrackStatus {
  RUNNING
  DONE
  FAILED
}

enum TriggerAudience {
  ANY
  NEW_CONTACT
  RETURNING_CONTACT
  REOPENED
}

enum TriggerSourceFilter {
  ANY
  // Click-to-Direct ad (message.referral.source = ADS).
  ADS
  // ig.me link with a ref parameter.
  LINK
}

enum TriggerMessageDirection {
  INBOUND
  OUTBOUND
}

/// One normalised Instagram event. Unique per account + Meta message/comment
/// id, which is what makes a redelivered webhook a no-op.
model InstagramEvent {
  id                  String               @id @default(cuid())
  workspaceId         String
  instagramAccountId  String
  eventType           InstagramEventType
  senderId            String
  senderUsername      String?
  // Meta's mid (DM / story reply / mention) or the comment id (comments).
  messageId           String
  storyId             String?
  storyUrl            String?
  mediaId             String?
  text                String               @default("")
  // Our own button / quick-reply payload ("c2:...") when the event is a tap.
  payload             String?
  // message.referral: "ADS" for click-to-Direct ads, or the ig.me link source.
  referralSource      String?
  adId                String?
  // ig.me link ref parameter.
  ref                 String?
  // MESSAGE_REACTION: the emoji / reaction name and the message reacted to.
  reaction            String?
  reactedMid          String?
  timestamp           DateTime
  rawPayload          Json
  processingStatus    InstagramEventStatus @default(PENDING)
  // Short reason shown in the logs (why it was ignored / why it failed).
  error               String?
  // Full technical detail behind a failure.
  errorDetail         String?
  attempts            Int                  @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?
  contactId           String?
  conversationId      String?
  // ETAP 3: the DIRECT_MESSAGE / STORY_MENTION campaign the webhook decided
  // will answer this event (lib/triggers/claim.ts decideDmTrigger). Decided
  // once, stored with the event; the worker only answers with this campaign,
  // and production (DM keywords, assistant) skips the event when it is set.
  claimedCampaignId   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount   @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          InstagramContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  claimedCampaign  TriggerCampaign?   @relation(fields: [claimedCampaignId], references: [id], onDelete: SetNull)
  executions       TriggerExecution[]
  // Set when the event was queued by a backtrack scan, not a webhook.
  backtrackRunId   String?
  backtrackRun     TriggerBacktrackRun? @relation(fields: [backtrackRunId], references: [id], onDelete: SetNull)

  @@unique([instagramAccountId, messageId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, eventType, createdAt])
  @@index([processingStatus, updatedAt])
  // The person's history on the account (audience, reopened, cooldown claims).
  @@index([instagramAccountId, senderId, timestamp])
  // ON DELETE SET NULL when a campaign is deleted.
  @@index([claimedCampaignId])
}

model TriggerCampaign {
  id                 String              @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  name               String
  triggerType        InstagramEventType
  storyScope         TriggerStoryScope   @default(ALL)
  storyIds           String[]            @default([])
  keywords           String[]            @default([])
  matchingMode       TriggerMatchMode    @default(EVERY)
  responseType       TriggerResponseType @default(SEND_MESSAGE)
  responseMessage    String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // -- Comment Automation 2.0 (triggerType COMMENT) --------------------------
  // Which posts: every post, or only mediaIds.
  mediaScope         TriggerMediaScope   @default(ANY)
  mediaIds           String[]            @default([])
  // Built-in intents (lib/triggers/keywords.ts) matched next to keywords.
  intents            String[]            @default([])
  // Tie-breaker between equally specific matches; higher wins.
  priority           Int                 @default(0)
  replyMode          TriggerReplyMode    @default(RANDOM)
  // Next index for SEQUENTIAL mode; advanced atomically per send.
  sequenceCursor     Int                 @default(0)
  publicReplyEnabled Boolean             @default(false)
  // Set: the private reply carries this button, and tapping it opens the
  // 24h window for mainMessage, quick replies and follow-ups.
  openingButtonLabel String?
  mainMessage        String?
  stopOnReply        Boolean             @default(true)
  stopOnLead         Boolean             @default(true)
  stopOnHandoff      Boolean             @default(true)

  // -- ETAP 3: DM-side triggers (Direct, Story Mention, Ad message) ----------
  audience           TriggerAudience     @default(ANY)
  // REOPENED audience: the person's previous message is older than this.
  reopenAfterHours   Int                 @default(72)
  // One answer per person per campaign within this many hours (anti-spam).
  cooldownHours      Int                 @default(24)
  sourceFilter       TriggerSourceFilter @default(ANY)
  // sourceFilter ADS: only these ads (empty = any ad).
  adIds              String[]            @default([])
  // sourceFilter LINK: only these ig.me ref values (empty = any link).
  refs               String[]            @default([])

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount      @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  executions       TriggerExecution[]
  claimedEvents    InstagramEvent[]
  replyVariants    TriggerReplyVariant[]
  quickReplies     TriggerQuickReply[]
  followUpSteps    TriggerFollowUpStep[]
  backtrackRuns    TriggerBacktrackRun[]

  @@index([workspaceId])
  @@index([instagramAccountId, triggerType, active])
}

/// The action one campaign took for one event. Unique per (event, campaign) so
/// a retried job can see that the DM already went out.
model TriggerExecution {
  id             String                 @id @default(cuid())
  workspaceId    String
  eventId        String
  campaignId     String
  status         TriggerExecutionStatus @default(PENDING)
  matchedKeyword String?
  responseText   String
  sentMessageId  String?
  attempts       Int                    @default(0)
  error          String?
  errorDetail    String?
  nextRetryAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // -- Comment Automation 2.0 ------------------------------------------------
  variantId         String?
  publicReplyStatus TriggerSideStatus?
  publicReplyError  String?
  // The person tapped the opening button: the 24h window is open.
  openedAt          DateTime?
  // Last message from the person in this thread; the 24h window runs from it.
  lastInboundAt     DateTime?
  leadCapturedAt    DateTime?
  handedOffAt       DateTime?
  // Why follow-ups stopped (reply, lead, handoff, manual cancel).
  stoppedAt         DateTime?
  stopReason        String?

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     InstagramEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaign  TriggerCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant   TriggerReplyVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  followUps TriggerFollowUpRun[]

  @@unique([eventId, campaignId])
  @@index([workspaceId, createdAt])
  @@index([campaignId, createdAt])
}

model InstagramContact {
  id                 String             @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  // Instagram-scoped id of the person.
  igUserId           String
  username           String?
  name               String?
  // The event type that first brought this person in.
  source             InstagramEventType
  firstInteractionAt DateTime
  lastInteractionAt  DateTime
  interactionCount   Int                @default(0)
  // Shared by the person through a lead-capture quick reply.
  phone              String?
  email              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  conversation     TriggerConversation?
  events           InstagramEvent[]

  @@unique([instagramAccountId, igUserId])
  @@index([workspaceId, lastInteractionAt])
}

model TriggerConversation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  contactId          String   @unique
  lastMessageAt      DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          InstagramContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages         TriggerMessage[]

  @@index([workspaceId, lastMessageAt])
}

model TriggerMessage {
  id             String                  @id @default(cuid())
  conversationId String
  direction      TriggerMessageDirection
  eventType      InstagramEventType?
  text           String
  // Instagram message id; unique per conversation so a retry never stores twice.
  mid            String?
  storyId        String?
  eventId        String?
  executionId    String?
  createdAt      DateTime                @default(now())

  conversation TriggerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, mid])
  @@index([conversationId, createdAt])
}

// --- Comment Automation 2.0 (developer area, ETAP 2) -------------------------

/// One reply text a campaign can send. AI drafts start unapproved and are
/// never sent until someone approves them (TZ 10: generate -> approve).
model TriggerReplyVariant {
  id         String               @id @default(cuid())
  campaignId String
  kind       TriggerVariantKind
  text       String
  // WEIGHTED mode: relative chance; ignored by RANDOM / SEQUENTIAL.
  weight     Int                  @default(1)
  sort       Int                  @default(0)
  source     TriggerVariantSource @default(MANUAL)
  approvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  campaign   TriggerCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  executions TriggerExecution[]

  @@index([campaignId, kind, sort])
}

/// A quick-reply button on the campaign's main message (max 13, 20 chars).
model TriggerQuickReply {
  id           String                  @id @default(cuid())
  campaignId   String
  label        String
  action       TriggerQuickReplyAction
  // MESSAGE: the text sent back. LEAD_CAPTURE / HANDOFF: optional reply.
  responseText String?
  sort         Int                     @default(0)
  createdAt    DateTime                @default(now())

  campaign TriggerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sort])
}

/// One follow-up message in a campaign's sequence.
model TriggerFollowUpStep {
  id           String                   @id @default(cuid())
  campaignId   String
  sort         Int                      @default(0)
  // Counted from the moment the window opened (tap) or the DM went out.
  delayMinutes Int
  condition    TriggerFollowUpCondition @default(ALWAYS)
  message      String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  campaign TriggerCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  runs     TriggerFollowUpRun[]

  @@index([campaignId, sort])
}

/// A scheduled follow-up for one execution. Unique per (execution, step) so a
/// step is never scheduled - or sent - twice.
model TriggerFollowUpRun {
  id          String                @id @default(cuid())
  workspaceId String
  executionId String
  stepId      String
  status      TriggerFollowUpStatus @default(SCHEDULED)
  scheduledAt DateTime
  sentAt      DateTime?
  // Why it was skipped / cancelled / failed, in Uzbek for the logs.
  reason      String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution TriggerExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step      TriggerFollowUpStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([executionId, stepId])
  @@index([status, scheduledAt])
  @@index([workspaceId, createdAt])
}

/// "Send to earlier comments too" (TZ 11): one scan of a campaign's posts.
model TriggerBacktrackRun {
  id               String                 @id @default(cuid())
  workspaceId      String
  campaignId       String
  // Capped at 7: Meta only allows private replies within 7 days.
  days             Int
  status           TriggerBacktrackStatus @default(RUNNING)
  scanned          Int                    @default(0)
  queued           Int                    @default(0)
  skippedDuplicate Int                    @default(0)
  skippedNoMatch   Int                    @default(0)
  skippedExpired   Int                    @default(0)
  error            String?
  startedAt        DateTime               @default(now())
  finishedAt       DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  TriggerCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events    InstagramEvent[]

  @@index([campaignId, startedAt])
}

// --- JavobAI (developer area, ETAP 4) ----------------------------------------
// Everything here is new: production's Conversation / Lead / AssistantProfile
// are shared read-mostly, never altered. See docs/developer/etap-4-javobai.md.

enum JavobAiMode {
  OFF
  // Production answers; JavobAI computes its reply and only logs it.
  SHADOW
  LIVE
}

enum AiHandoffState {
  AI_ACTIVE
  HANDOFF_PENDING
  OPERATOR_ACTIVE
  CLOSED
}

enum AiTemperature {
  COLD
  WARM
  HOT
  CUSTOMER
  LOST
}

enum AiHandoffStatus {
  OPEN
  ACCEPTED
  CLOSED
}

enum AiHandoffRuleKind {
  KEYWORD
  INTENT
  SCORE
  UNKNOWN_COUNT
  OFF_HOURS
}

enum AiKnowledgeKind {
  DISCOUNT
  CONTACT
  TERMS
  BRANCH
  POLICY
  OTHER
}

/// Which Instagram accounts JavobAI handles, and how. Rows exist only for
/// accounts the developer switched on; no row = OFF.
model JavobAiAccount {
  id                 String      @id @default(cuid())
  workspaceId        String
  instagramAccountId String      @unique
  mode               JavobAiMode @default(OFF)
  // Per-account knobs (confidence threshold, unknown streak, qualification
  // questions, max turns...). Validated by lib/javobai/config.ts.
  config             Json        @default("{}")
  enabledBy          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// JavobAI's own state for a production Conversation (1:1).
model AiConversationState {
  id             String         @id @default(cuid())
  conversationId String         @unique
  handoffState   AiHandoffState @default(AI_ACTIVE)
  score          Int            @default(0)
  temperature    AiTemperature  @default(COLD)
  // Rolling summary of everything older than the message window.
  summary        String         @default("")
  summaryUpToMessageId String?
  // email, budget, location, product... as extracted by code from turns.
  extracted      Json           @default("{}")
  // Campaign / trigger that opened the thread (name, main message, ad id).
  context        Json           @default("{}")
  unknownStreak  Int            @default(0)
  turns          Int            @default(0)
  // Mirrors Conversation.leadCycle so score events reset per lead.
  leadCycle      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scoreEvents  AiScoreEvent[]
}

/// One scoring signal, counted once per lead cycle (idempotent on retries).
model AiScoreEvent {
  id        String   @id @default(cuid())
  stateId   String
  leadCycle Int
  signal    String
  points    Int
  messageId String?
  createdAt DateTime @default(now())

  state AiConversationState @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, leadCycle, signal])
}

/// Scoring rules and thresholds (TZ 24). One per workspace, optionally
/// overridden per account.
model AiScoringConfig {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  // [{ signal, points }]
  rules              Json
  // { warm, hot, veryHot }
  thresholds         Json
  handoffAtScore     Int?
  // Days of silence after which a WARM/HOT contact is marked LOST (null = never).
  lostAfterDays      Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, instagramAccountId])
}

/// One handoff episode (TZ 25).
model AiHandoff {
  id             String          @id @default(cuid())
  conversationId String
  reason         String
  status         AiHandoffStatus @default(OPEN)
  openedAt       DateTime        @default(now())
  acceptedAt     DateTime?
  acceptedBy     String?
  closedAt       DateTime?
  closedBy       String?
  // After close: does the AI take the next customer message again?
  resumeAi       Boolean         @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, openedAt])
  @@index([status, openedAt])
}

/// Business rules that force a handoff (TZ 25 "business rule").
model AiHandoffRule {
  id          String            @id @default(cuid())
  workspaceId String
  kind        AiHandoffRuleKind
  // KEYWORD: { keywords: [] }, INTENT: { intents: [] }, SCORE: { min },
  // UNKNOWN_COUNT: { count }, OFF_HOURS: { from: "HH:MM", to: "HH:MM" }
  value       Json
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

/// What JavobAI remembers about a person across conversations (TZ 22.1).
model AiContactMemory {
  id                 String   @id @default(cuid())
  instagramAccountId String
  igUserId           String
  // name, language, preferences, past interests...
  facts              Json     @default("{}")
  lastSummary        String   @default("")
  leadIds            String[] @default([])
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([instagramAccountId, igUserId])
}

/// Verified business facts beyond the profile: discounts, contacts, terms,
/// branches, policies (TZ 20). Unverified entries are never shown to the AI.
model AiKnowledgeEntry {
  id         String          @id @default(cuid())
  profileId  String
  kind       AiKnowledgeKind
  title      String
  body       String
  verifiedAt DateTime?
  active     Boolean         @default(true)
  sort       Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([profileId, active, sort])
}

/// Score, temperature and extra fields for a production Lead (1:1).
model AiLeadInsight {
  id          String        @id @default(cuid())
  leadId      String        @unique
  score       Int
  temperature AiTemperature
  email       String?
  budget      String?
  location    String?
  // [{ signal, points }] at the time the lead was created.
  signals     Json          @default("[]")
  isTest      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/// SHADOW mode: JavobAI's reply next to production's, for review.
model AiShadowTurn {
  id              String   @id @default(cuid())
  workspaceId     String
  conversationId  String?
  customerText    String
  productionReply String?
  aiReply         String?
  intent          String?
  confidence      Float?
  score           Int?
  handoff         String?
  costUsd         Decimal  @default(0) @db.Decimal(12, 6)
  error           String?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// Monthly USD budget per workspace with alert bookkeeping (TZ 66).
model AiBudget {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  monthlyUsdSoft Decimal  @db.Decimal(12, 2)
  monthlyUsdHard Decimal? @db.Decimal(12, 2)
  alerted50At   DateTime?
  alerted80At   DateTime?
  alerted100At  DateTime?
  periodStart   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
