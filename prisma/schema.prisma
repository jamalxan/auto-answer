// ─── Instagram Trigger Engine (DEV) ────────────────────────────────────────────
//
// A shared event pipeline: webhook → normalised InstagramEvent → trigger
// matching → TriggerExecution (the action). Kept apart from the comment→DM
// campaigns (Automation / DmLog) and the lead assistant (Conversation) until it
// is promoted out of dev mode — see lib/triggers/README.md.

enum InstagramEventType {
  STORY_REPLY
  STORY_MENTION
  DIRECT_MESSAGE
  LIVE_COMMENT
  // Reserved: not produced by the normaliser until the payload of a story
  // reaction is confirmed against real webhooks.
  STORY_REACTION
  COMMENT
  // Any reaction to a message (message_reactions). Stored in observation mode
  // only: whether story reactions arrive this way is not documented.
  MESSAGE_REACTION
  // Logged-only webhook items (always IGNORED, never answered): the account's
  // own echoes, postbacks production handles, and every other webhook field.
  ECHO
  POSTBACK
  OTHER
}

enum InstagramEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  IGNORED
  RETRYING
  FAILED
}

enum TriggerStoryScope {
  ALL
  SPECIFIC
}

enum TriggerMatchMode {
  EVERY
  CONTAINS
  EXACT
}

enum TriggerResponseType {
  SEND_MESSAGE
}

enum TriggerExecutionStatus {
  PENDING
  // Set right before the Instagram call. Found again on a re-run it means the
  // process died mid-send, so the engine stops instead of risking a second DM.
  SENDING
  SENT
  RETRYING
  FAILED
  SKIPPED
}

enum TriggerMediaScope {
  ANY
  SPECIFIC
}

enum TriggerReplyMode {
  RANDOM
  SEQUENTIAL
  WEIGHTED
}

enum TriggerVariantKind {
  DM
  PUBLIC
}

enum TriggerVariantSource {
  MANUAL
  AI
}

enum TriggerQuickReplyAction {
  MESSAGE
  LEAD_CAPTURE
  HANDOFF
  // Hands the thread to JavobAI (ETAP 4); only honoured on a LIVE account,
  // otherwise behaves like HANDOFF.
  AI
}

enum TriggerFollowUpCondition {
  ALWAYS
  // Only if the person has not written anything since the trigger.
  NO_REPLY
  // Only if the person has not tapped the opening button.
  NO_CLICK
}

enum TriggerFollowUpStatus {
  SCHEDULED
  SENDING
  SENT
  SKIPPED
  CANCELLED
  FAILED
}

enum TriggerSideStatus {
  SENT
  FAILED
}

enum TriggerBacktrackStatus {
  RUNNING
  DONE
  FAILED
}

enum TriggerCampaignKind {
  CAMPAIGN
  FLOW
}

enum TriggerAudience {
  ANY
  NEW_CONTACT
  RETURNING_CONTACT
  REOPENED
}

enum TriggerSourceFilter {
  ANY
  // Click-to-Direct ad (message.referral.source = ADS).
  ADS
  // ig.me link with a ref parameter.
  LINK
}

enum TriggerMessageDirection {
  INBOUND
  OUTBOUND
}

/// One normalised Instagram event. Unique per account + Meta message/comment
/// id, which is what makes a redelivered webhook a no-op.
model InstagramEvent {
  id                  String               @id @default(cuid())
  workspaceId         String
  instagramAccountId  String
  eventType           InstagramEventType
  senderId            String
  senderUsername      String?
  // Meta's mid (DM / story reply / mention) or the comment id (comments).
  messageId           String
  storyId             String?
  storyUrl            String?
  mediaId             String?
  text                String               @default("")
  // Our own button / quick-reply payload ("c2:...") when the event is a tap.
  payload             String?
  // message.referral: "ADS" for click-to-Direct ads, or the ig.me link source.
  referralSource      String?
  adId                String?
  // ig.me link ref parameter.
  ref                 String?
  // MESSAGE_REACTION: the emoji / reaction name and the message reacted to.
  reaction            String?
  reactedMid          String?
  timestamp           DateTime
  rawPayload          Json
  processingStatus    InstagramEventStatus @default(PENDING)
  // Short reason shown in the logs (why it was ignored / why it failed).
  error               String?
  // Full technical detail behind a failure.
  errorDetail         String?
  attempts            Int                  @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?
  contactId           String?
  conversationId      String?
  // ETAP 3: the DIRECT_MESSAGE / STORY_MENTION campaign the webhook decided
  // will answer this event (lib/triggers/claim.ts decideDmTrigger). Decided
  // once, stored with the event; the worker only answers with this campaign,
  // and production (DM keywords, assistant) skips the event when it is set.
  claimedCampaignId   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          InstagramContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  claimedCampaign  TriggerCampaign?     @relation(fields: [claimedCampaignId], references: [id], onDelete: SetNull)
  executions       TriggerExecution[]
  // Set when the event was queued by a backtrack scan, not a webhook.
  backtrackRunId   String?
  backtrackRun     TriggerBacktrackRun? @relation(fields: [backtrackRunId], references: [id], onDelete: SetNull)

  @@unique([instagramAccountId, messageId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, eventType, createdAt])
  @@index([processingStatus, updatedAt])
  // The person's history on the account (audience, reopened, cooldown claims).
  @@index([instagramAccountId, senderId, timestamp])
  // ON DELETE SET NULL when a campaign is deleted.
  @@index([claimedCampaignId])
  @@index([createdAt, id]) // CRM reconciler keyset scan
}

model TriggerCampaign {
  id                 String              @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  name               String
  triggerType        InstagramEventType
  storyScope         TriggerStoryScope   @default(ALL)
  storyIds           String[]            @default([])
  keywords           String[]            @default([])
  matchingMode       TriggerMatchMode    @default(EVERY)
  responseType       TriggerResponseType @default(SEND_MESSAGE)
  responseMessage    String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // -- Comment Automation 2.0 (triggerType COMMENT) --------------------------
  // Which posts: every post, or only mediaIds.
  mediaScope         TriggerMediaScope @default(ANY)
  mediaIds           String[]          @default([])
  // Built-in intents (lib/triggers/keywords.ts) matched next to keywords.
  intents            String[]          @default([])
  // Tie-breaker between equally specific matches; higher wins.
  priority           Int               @default(0)
  replyMode          TriggerReplyMode  @default(RANDOM)
  // Next index for SEQUENTIAL mode; advanced atomically per send.
  sequenceCursor     Int               @default(0)
  publicReplyEnabled Boolean           @default(false)
  // Set: the private reply carries this button, and tapping it opens the
  // 24h window for mainMessage, quick replies and follow-ups.
  openingButtonLabel String?
  mainMessage        String?
  stopOnReply        Boolean           @default(true)
  stopOnLead         Boolean           @default(true)
  stopOnHandoff      Boolean           @default(true)
  // Stop follow-ups once the person bought: a Lead was created or a CRM deal is WON.
  stopOnPurchase     Boolean           @default(true)

  // -- ETAP 6: a published Flow owns a hidden proxy row so the webhook's single
  // claim / matching / gate logic stays the only one. CAMPAIGN = normal rows.
  kind TriggerCampaignKind @default(CAMPAIGN)
  flow Flow?

  // -- ETAP 3: DM-side triggers (Direct, Story Mention, Ad message) ----------
  audience         TriggerAudience     @default(ANY)
  // REOPENED audience: the person's previous message is older than this.
  reopenAfterHours Int                 @default(72)
  // One answer per person per campaign within this many hours (anti-spam).
  cooldownHours    Int                 @default(24)
  sourceFilter     TriggerSourceFilter @default(ANY)
  // sourceFilter ADS: only these ads (empty = any ad).
  adIds            String[]            @default([])
  // sourceFilter LINK: only these ig.me ref values (empty = any link).
  refs             String[]            @default([])

  // Content Scheduler (ETAP 13): waits for this post; on publish
  // mediaIds = [igMediaId], mediaScope = SPECIFIC, active = true.
  scheduledPostId String?

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount      @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  scheduledPost    ScheduledPost?        @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)
  executions       TriggerExecution[]
  claimedEvents    InstagramEvent[]
  replyVariants    TriggerReplyVariant[]
  quickReplies     TriggerQuickReply[]
  followUpSteps    TriggerFollowUpStep[]
  backtrackRuns    TriggerBacktrackRun[]

  @@index([workspaceId])
  @@index([instagramAccountId, triggerType, active])
}

/// The action one campaign took for one event. Unique per (event, campaign) so
/// a retried job can see that the DM already went out.
model TriggerExecution {
  id             String                 @id @default(cuid())
  workspaceId    String
  eventId        String
  campaignId     String
  status         TriggerExecutionStatus @default(PENDING)
  matchedKeyword String?
  responseText   String
  sentMessageId  String?
  attempts       Int                    @default(0)
  error          String?
  errorDetail    String?
  nextRetryAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // -- Comment Automation 2.0 ------------------------------------------------
  variantId         String?
  publicReplyStatus TriggerSideStatus?
  publicReplyError  String?
  // The person tapped the opening button: the 24h window is open.
  openedAt          DateTime?
  // Last message from the person in this thread; the 24h window runs from it.
  lastInboundAt     DateTime?
  leadCapturedAt    DateTime?
  // First message from the person after the trigger (analytics: replies).
  firstInboundAt    DateTime?
  handedOffAt       DateTime?
  // Why follow-ups stopped (reply, lead, handoff, manual cancel).
  stoppedAt         DateTime?
  stopReason        String?

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     InstagramEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaign  TriggerCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant   TriggerReplyVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  followUps TriggerFollowUpRun[]

  @@unique([eventId, campaignId])
  @@index([workspaceId, createdAt])
  @@index([campaignId, createdAt])
  @@index([updatedAt, id]) // CRM reconciler keyset scan
}

model InstagramContact {
  id                 String             @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  // Instagram-scoped id of the person.
  igUserId           String
  username           String?
  name               String?
  // The event type that first brought this person in.
  source             InstagramEventType
  firstInteractionAt DateTime
  lastInteractionAt  DateTime
  interactionCount   Int                @default(0)
  // Shared by the person through a lead-capture quick reply.
  phone              String?
  email              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  conversation     TriggerConversation?
  events           InstagramEvent[]

  @@unique([instagramAccountId, igUserId])
  @@index([workspaceId, lastInteractionAt])
}

model TriggerConversation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  contactId          String   @unique
  lastMessageAt      DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          InstagramContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages         TriggerMessage[]

  @@index([workspaceId, lastMessageAt])
}

model TriggerMessage {
  id             String                  @id @default(cuid())
  conversationId String
  direction      TriggerMessageDirection
  eventType      InstagramEventType?
  text           String
  // Instagram message id; unique per conversation so a retry never stores twice.
  mid            String?
  storyId        String?
  eventId        String?
  executionId    String?
  createdAt      DateTime                @default(now())

  conversation TriggerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, mid])
  @@index([conversationId, createdAt])
}

// --- Comment Automation 2.0 (developer area, ETAP 2) -------------------------

/// One reply text a campaign can send. AI drafts start unapproved and are
/// never sent until someone approves them (TZ 10: generate -> approve).
model TriggerReplyVariant {
  id         String               @id @default(cuid())
  campaignId String
  kind       TriggerVariantKind
  text       String
  // WEIGHTED mode: relative chance; ignored by RANDOM / SEQUENTIAL.
  weight     Int                  @default(1)
  sort       Int                  @default(0)
  source     TriggerVariantSource @default(MANUAL)
  approvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  campaign   TriggerCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  executions TriggerExecution[]

  @@index([campaignId, kind, sort])
}

/// A quick-reply button on the campaign's main message (max 13, 20 chars).
model TriggerQuickReply {
  id           String                  @id @default(cuid())
  campaignId   String
  label        String
  action       TriggerQuickReplyAction
  // MESSAGE: the text sent back. LEAD_CAPTURE / HANDOFF: optional reply.
  responseText String?
  sort         Int                     @default(0)
  createdAt    DateTime                @default(now())

  campaign TriggerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sort])
}

/// One follow-up message in a campaign's sequence.
model TriggerFollowUpStep {
  id           String                   @id @default(cuid())
  campaignId   String
  sort         Int                      @default(0)
  // Counted from the moment the window opened (tap) or the DM went out.
  delayMinutes Int
  condition    TriggerFollowUpCondition @default(ALWAYS)
  message      String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  campaign TriggerCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  runs     TriggerFollowUpRun[]

  @@index([campaignId, sort])
}

/// A scheduled follow-up for one execution. Unique per (execution, step) so a
/// step is never scheduled - or sent - twice.
model TriggerFollowUpRun {
  id          String                @id @default(cuid())
  workspaceId String
  executionId String
  stepId      String
  status      TriggerFollowUpStatus @default(SCHEDULED)
  scheduledAt DateTime
  sentAt      DateTime?
  // Why it was skipped / cancelled / failed, in Uzbek for the logs.
  reason      String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution TriggerExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step      TriggerFollowUpStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([executionId, stepId])
  @@index([status, scheduledAt])
  @@index([workspaceId, createdAt])
}

/// "Send to earlier comments too" (TZ 11): one scan of a campaign's posts.
model TriggerBacktrackRun {
  id               String                 @id @default(cuid())
  workspaceId      String
  campaignId       String
  // Capped at 7: Meta only allows private replies within 7 days.
  days             Int
  status           TriggerBacktrackStatus @default(RUNNING)
  scanned          Int                    @default(0)
  queued           Int                    @default(0)
  skippedDuplicate Int                    @default(0)
  skippedNoMatch   Int                    @default(0)
  skippedExpired   Int                    @default(0)
  error            String?
  startedAt        DateTime               @default(now())
  finishedAt       DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  TriggerCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events    InstagramEvent[]

  @@index([campaignId, startedAt])
}

// --- JavobAI (developer area, ETAP 4) ----------------------------------------
// Everything here is new: production's Conversation / Lead / AssistantProfile
// are shared read-mostly, never altered. See docs/developer/etap-4-javobai.md.

enum JavobAiMode {
  OFF
  // Production answers; JavobAI computes its reply and only logs it.
  SHADOW
  LIVE
}

enum AiHandoffState {
  AI_ACTIVE
  HANDOFF_PENDING
  OPERATOR_ACTIVE
  CLOSED
}

enum AiTemperature {
  COLD
  WARM
  HOT
  CUSTOMER
  LOST
}

enum AiHandoffStatus {
  OPEN
  ACCEPTED
  CLOSED
}

enum AiHandoffRuleKind {
  KEYWORD
  INTENT
  SCORE
  UNKNOWN_COUNT
  OFF_HOURS
}

enum AiKnowledgeKind {
  DISCOUNT
  CONTACT
  TERMS
  BRANCH
  POLICY
  OTHER
  // Trust ladder (audit 2026-10-26): the facts a price / hours / delivery answer needs.
  PRICE
  HOURS
  DELIVERY
}

/// Which Instagram accounts JavobAI handles, and how. Rows exist only for
/// accounts the developer switched on; no row = OFF.
model JavobAiAccount {
  id                 String      @id @default(cuid())
  workspaceId        String
  instagramAccountId String      @unique
  mode               JavobAiMode @default(OFF)
  // Per-account knobs (confidence threshold, unknown streak, qualification
  // questions, max turns...). Validated by lib/javobai/config.ts.
  config             Json        @default("{}")
  enabledBy          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// JavobAI's own state for a production Conversation (1:1).
model AiConversationState {
  id                   String         @id @default(cuid())
  conversationId       String         @unique
  handoffState         AiHandoffState @default(AI_ACTIVE)
  score                Int            @default(0)
  temperature          AiTemperature  @default(COLD)
  // Rolling summary of everything older than the message window.
  summary              String         @default("")
  summaryUpToMessageId String?
  // email, budget, location, product... as extracted by code from turns.
  extracted            Json           @default("{}")
  // Campaign / trigger that opened the thread (name, main message, ad id).
  context              Json           @default("{}")
  unknownStreak        Int            @default(0)
  turns                Int            @default(0)
  // Mirrors Conversation.leadCycle so score events reset per lead.
  leadCycle            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scoreEvents  AiScoreEvent[]

  @@index([updatedAt, id]) // CRM reconciler keyset scan
}

/// One scoring signal, counted once per lead cycle (idempotent on retries).
model AiScoreEvent {
  id        String   @id @default(cuid())
  stateId   String
  leadCycle Int
  signal    String
  points    Int
  messageId String?
  createdAt DateTime @default(now())

  state AiConversationState @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, leadCycle, signal])
}

/// Scoring rules and thresholds (TZ 24). One per workspace, optionally
/// overridden per account.
model AiScoringConfig {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  // [{ signal, points }]
  rules              Json
  // { warm, hot, veryHot }
  thresholds         Json
  handoffAtScore     Int?
  // Days of silence after which a WARM/HOT contact is marked LOST (null = never).
  lostAfterDays      Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, instagramAccountId])
}

/// One handoff episode (TZ 25).
model AiHandoff {
  id             String          @id @default(cuid())
  conversationId String
  reason         String
  status         AiHandoffStatus @default(OPEN)
  openedAt       DateTime        @default(now())
  acceptedAt     DateTime?
  acceptedBy     String?
  closedAt       DateTime?
  closedBy       String?
  // After close: does the AI take the next customer message again?
  resumeAi       Boolean         @default(true)
  // Nobody accepted in time: the second manager was alerted (audit 2026-10-26).
  escalatedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, openedAt])
  @@index([status, openedAt])
  @@index([openedAt, id]) // CRM reconciler keyset scan
}

/// Business rules that force a handoff (TZ 25 "business rule").
model AiHandoffRule {
  id          String            @id @default(cuid())
  workspaceId String
  kind        AiHandoffRuleKind
  // KEYWORD: { keywords: [] }, INTENT: { intents: [] }, SCORE: { min },
  // UNKNOWN_COUNT: { count }, OFF_HOURS: { from: "HH:MM", to: "HH:MM" }
  value       Json
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

/// What JavobAI remembers about a person across conversations (TZ 22.1).
model AiContactMemory {
  id                 String   @id @default(cuid())
  instagramAccountId String
  igUserId           String
  // name, language, preferences, past interests...
  facts              Json     @default("{}")
  lastSummary        String   @default("")
  leadIds            String[] @default([])
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([instagramAccountId, igUserId])
}

/// Verified business facts beyond the profile: discounts, contacts, terms,
/// branches, policies (TZ 20). Unverified entries are never shown to the AI.
model AiKnowledgeEntry {
  id         String          @id @default(cuid())
  profileId  String
  kind       AiKnowledgeKind
  title      String
  body       String
  verifiedAt DateTime?
  /// A fact with a shelf life (a price, a promo): past this it leaves the prompt and the intent that needed it drops to copilot.
  expiresAt  DateTime?
  /// owner (typed in the KB) | observed (approved candidate from operator replies) | manager_reply (Telegram "add to KB")
  source     String          @default("owner")
  active     Boolean         @default(true)
  sort       Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([profileId, active, sort])
}

/// Score, temperature and extra fields for a production Lead (1:1).
model AiLeadInsight {
  id          String        @id @default(cuid())
  leadId      String        @unique
  score       Int
  temperature AiTemperature
  email       String?
  budget      String?
  location    String?
  // [{ signal, points }] at the time the lead was created.
  signals     Json          @default("[]")
  isTest      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/// SHADOW mode: JavobAI's reply next to production's, for review.
model AiShadowTurn {
  id              String   @id @default(cuid())
  workspaceId     String
  conversationId  String?
  customerText    String
  productionReply String?
  aiReply         String?
  intent          String?
  confidence      Float?
  score           Int?
  handoff         String?
  costUsd         Decimal  @default(0) @db.Decimal(12, 6)
  error           String?
  // -- Trust ladder (audit 2026-10-26): one row = one comparison sample --
  instagramAccountId String?
  /// shadow (account SHADOW mode) | observe (intent in OBSERVE) | copilot (a draft) | auto (sent; a later operator message is a correction)
  source             String    @default("shadow")
  customerMessageId  String?
  /// What the human actually sent (paired from the operator echo / the inbox / the copilot decision).
  operatorReply      String?
  operatorRepliedAt  DateTime?
  /// LLM judge: does the AI draft say what the operator said?
  judgeMatch         Boolean?
  judgeScore         Float?
  /// none | wrong_price | wrong_fact | promise | tone | policy
  critical           String?
  judgeNotes         String?
  judgedAt           DateTime?
  factsExtractedAt   DateTime?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([instagramAccountId, intent, createdAt])
  @@index([conversationId, createdAt])
}

/// Monthly USD budget per workspace with alert bookkeeping (TZ 66).
model AiBudget {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  monthlyUsdSoft Decimal   @db.Decimal(12, 2)
  monthlyUsdHard Decimal?  @db.Decimal(12, 2)
  alerted50At    DateTime?
  alerted80At    DateTime?
  alerted100At   DateTime?
  periodStart    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// --- CRM / Lead Management (developer area, ETAP 5) --------------------------
// New tables only. Production Conversation / Lead / InstagramContact are linked
// by plain ids and never altered. See docs/developer/etap-5-crm.md and
// lib/crm/types.ts (the string unions mirror these enums 1:1).

enum CrmContactStatus {
  NEW
  ACTIVE
  CUSTOMER
  LOST
  ARCHIVED
}

enum CrmContactSource {
  COMMENT
  STORY
  DM
  AD
  LINK
  BROADCAST
  IMPORT
  UNKNOWN
}

enum CrmTagOrigin {
  MANUAL
  AI
  AUTOMATION
  SYSTEM
}

enum CrmStageKind {
  OPEN
  WON
  LOST
}

enum CrmAssignmentStrategy {
  ROUND_ROBIN
  TEAM
  SPECIALIST
}

enum CrmAssignmentTrigger {
  ON_HOT
  ON_LEAD
  ON_HANDOFF
  ON_STAGE
  MANUAL
}

enum CrmActivityType {
  INBOUND_MESSAGE
  AUTOMATION_REPLY
  AI_REPLY
  OPERATOR_REPLY
  FOLLOW_UP_SENT
  LEAD_CREATED
  LEAD_DELIVERED
  SCORE_CHANGED
  TEMPERATURE_CHANGED
  HANDOFF_OPENED
  HANDOFF_ACCEPTED
  HANDOFF_CLOSED
  TAG_ADDED
  TAG_REMOVED
  STAGE_CHANGED
  DEAL_CREATED
  ASSIGNED
  UNASSIGNED
  FIELD_CHANGED
  NOTE
  BROADCAST_SENT
  BROADCAST_SKIPPED
  BROADCAST_REPLIED
  BROADCAST_CONVERTED
  OPT_OUT
}

enum CrmActorKind {
  SYSTEM
  AI
  AUTOMATION
  OPERATOR
}

enum CrmBroadcastStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CrmRecipientStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

/// One person per Instagram business account: the single CRM identity that
/// links the trigger contact, the assistant conversation and the leads.
model CrmContact {
  id                 String           @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  igUserId           String
  username           String?
  name               String?
  phoneE164          String?
  email              String?
  language           String?
  source             CrmContactSource @default(UNKNOWN)
  status             CrmContactStatus @default(NEW)
  // Mirrors of AiConversationState; 0 / COLD when JavobAI never touched it.
  score              Int              @default(0)
  temperature        AiTemperature    @default(COLD)
  hasAiState         Boolean          @default(false)
  firstInteractionAt DateTime?
  lastInteractionAt  DateTime?
  // Customer message / tap: the 24h-window anchor for broadcasts.
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  interactionCount   Int              @default(0)
  assignedMemberId   String?
  assignedAt         DateTime?
  conversationId     String?          @unique
  instagramContactId String?          @unique
  optedOutAt         DateTime?
  optOutReason       String?
  mergedIntoId       String?
  customFields       Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags        CrmContactTag[]
  deals       CrmDeal[]
  activities  CrmActivity[]
  assignments CrmAssignment[]
  recipients  CrmBroadcastRecipient[]

  @@unique([instagramAccountId, igUserId])
  @@index([workspaceId, lastInteractionAt])
  @@index([workspaceId, status, score])
  @@index([workspaceId, assignedMemberId])
  @@index([workspaceId, phoneE164])
  @@index([workspaceId, lastInboundAt])
  @@index([workspaceId, temperature])
}

model CrmTag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  CrmContactTag[]

  @@unique([workspaceId, slug])
}

model CrmContactTag {
  id        String       @id @default(cuid())
  contactId String
  tagId     String
  origin    CrmTagOrigin
  // campaignId / ruleId / memberId / "ai:extracted.product"
  sourceRef String?
  createdAt DateTime     @default(now())

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     CrmTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([tagId])
}

/// Saved dynamic filter (lib/crm/segments.ts DSL).
model CrmSegment {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  filter          Json
  lastCount       Int?
  lastCountedAt   DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts CrmBroadcast[]

  @@index([workspaceId])
}

model CrmPipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    CrmStage[]
  deals     CrmDeal[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isDefault])
}

model CrmStage {
  id         String       @id @default(cuid())
  pipelineId String
  name       String
  sort       Int
  kind       CrmStageKind @default(OPEN)
  color      String?
  // New deals land here.
  isEntry    Boolean      @default(false)
  createdAt  DateTime     @default(now())

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    CrmDeal[]

  @@unique([pipelineId, name])
  @@index([pipelineId, sort])
}

/// A lead moving through a pipeline. One per production Lead.
model CrmDeal {
  id               String    @id @default(cuid())
  workspaceId      String
  contactId        String
  pipelineId       String
  stageId          String
  leadId           String?   @unique
  title            String
  stageEnteredAt   DateTime  @default(now())
  wonAt            DateTime?
  lostAt           DateTime?
  lostReason       String?
  assignedMemberId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   CrmContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipeline  CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage     CrmStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@index([workspaceId, pipelineId, stageId])
  @@index([contactId])
}

model CrmAssignmentRule {
  id              String                @id @default(cuid())
  workspaceId     String
  name            String
  active          Boolean               @default(true)
  priority        Int                   @default(0)
  trigger         CrmAssignmentTrigger
  stageId         String?
  strategy        CrmAssignmentStrategy
  // WorkspaceMember ids: the pool (ROUND_ROBIN) or the team.
  memberIds       String[]              @default([])
  productKeywords String[]              @default([])
  // Advanced atomically per assignment.
  rrCursor        Int                   @default(0)
  onlyUnassigned  Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments CrmAssignment[]

  @@index([workspaceId, active, priority])
}

model CrmAssignment {
  id               String    @id @default(cuid())
  workspaceId      String
  contactId        String
  dealId           String?
  memberId         String
  ruleId           String?
  // "rule:<id>" | "manual" | "telegram_take" | "inbox_reply" | "lead_contacted"
  reason           String
  assignedByUserId String?
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?
  active           Boolean   @default(true)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   CrmContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  rule      CrmAssignmentRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([contactId, active])
  @@index([workspaceId, memberId, active])
}

/// Timeline events that have no home elsewhere (tags, stages, assignments,
/// notes, broadcasts) plus denormalised state changes. Messages are read live.
model CrmActivity {
  id            String          @id @default(cuid())
  workspaceId   String
  contactId     String
  dealId        String?
  type          CrmActivityType
  occurredAt    DateTime
  actorKind     CrmActorKind
  actorMemberId String?
  title         String
  body          String?
  payload       Json?
  // Idempotency for rows synced from other tables.
  sourceTable   String?
  sourceId      String?
  createdAt     DateTime        @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sourceTable, sourceId, type])
  @@index([contactId, occurredAt])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, type, occurredAt])
}

/// Keyset cursor per source for the reconciler (lib/crm/sync.ts).
model CrmSyncCursor {
  source    String   @id
  cursorAt  DateTime
  cursorId  String?
  // Seeded at "now" on the first reconcile; the 30-day rescans never read before it (history = explicit backfill).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmBroadcast {
  id                   String             @id @default(cuid())
  workspaceId          String
  instagramAccountId   String
  name                 String
  segmentId            String?
  // Snapshot of the segment filter at schedule time.
  audienceFilter       Json
  message              String
  quickReplies         Json?
  status               CrmBroadcastStatus @default(DRAFT)
  scheduledAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  throttlePerHour      Int                @default(100)
  frequencyCapHours    Int                @default(24)
  replyWindowHours     Int                @default(48)
  conversionWindowDays Int                @default(7)
  totalCount           Int                @default(0)
  eligibleCount        Int                @default(0)
  sentCount            Int                @default(0)
  skippedCount         Int                @default(0)
  failedCount          Int                @default(0)
  repliedCount         Int                @default(0)
  convertedCount       Int                @default(0)
  lastError            String?
  // Delivery chain: every scheduled tick bumps tickSeq (job id bcb_<id>_<tickSeq>);
  // a tick whose seq is no longer current stops, so only one chain survives.
  tickSeq              Int                @default(0)
  // When the next tick is due; the maintenance sweep re-enqueues a lost chain from it.
  nextTickAt           DateTime?
  createdByUserId      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  segment    CrmSegment?             @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients CrmBroadcastRecipient[]

  @@index([workspaceId, status])
  @@index([status, scheduledAt])
}

model CrmBroadcastRecipient {
  id                  String             @id @default(cuid())
  broadcastId         String
  contactId           String
  eligible            Boolean
  // WINDOW_CLOSED | NO_INBOUND | OPTED_OUT | FREQUENCY_CAP | OPERATOR_ACTIVE |
  // TOKEN_BROKEN | SUSPENDED | DUPLICATE
  ineligibleReason    String?
  eligibilitySnapshot Json
  status              CrmRecipientStatus @default(PENDING)
  attempts            Int                @default(0)
  sentMessageId       String?
  sentAt              DateTime?
  error               String?
  repliedAt           DateTime?
  replyMessageId      String?
  convertedAt         DateTime?
  conversionDealId    String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  broadcast CrmBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   CrmContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  @@index([contactId, sentAt])
}

// --- Flow Builder (developer area, ETAP 6/7) ---------------------------------
// New tables only. The graph is immutable JSON on FlowVersion, validated by
// lib/flows/schema.ts. See docs/developer/etap-6-7-flow-builder.md.

enum FlowStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum FlowMode {
  SIMPLE
  ADVANCED
}

enum FlowVersionSource {
  MANUAL
  AI
  TEMPLATE
  IMPORT
}

enum FlowRunStatus {
  ACTIVE
  WAITING_TAP
  WAITING_INBOUND
  WAITING_DELAY
  DONE
  FAILED
  CANCELLED
}

enum FlowStepStatus {
  DONE
  SKIPPED
  FAILED
  WAITING
}

model Flow {
  id                 String             @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  name               String
  mode               FlowMode           @default(SIMPLE)
  status             FlowStatus         @default(DRAFT)
  // Mirrored from the version's trigger node, for lists and claims.
  triggerType        InstagramEventType
  draftVersionId     String?            @unique
  publishedVersionId String?            @unique
  // Hidden TriggerCampaign (kind FLOW) giving this flow a seat in claim logic.
  proxyCampaignId    String?            @unique
  createdByUserId    String?
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  proxyCampaign    TriggerCampaign? @relation(fields: [proxyCampaignId], references: [id], onDelete: SetNull)
  versions         FlowVersion[]
  runs             FlowRun[]

  @@index([workspaceId, status])
  @@index([instagramAccountId, status, triggerType])
}

model FlowVersion {
  id                String            @id @default(cuid())
  flowId            String
  version           Int
  schemaVersion     Int               @default(1)
  graph             Json
  // sha256 of the canonical graph JSON.
  hash              String
  source            FlowVersionSource @default(MANUAL)
  // AI builder input, so the Generate step is reproducible.
  prompt            String?
  changeNote        String?
  auditResult       Json?
  policyResult      Json?
  // Last successful sandbox run of this exact hash.
  testedAt          DateTime?
  approvedAt        DateTime?
  approvedByUserId  String?
  publishedAt       DateTime?
  publishedByUserId String?
  // Superseded or unpublished.
  retiredAt         DateTime?
  createdAt         DateTime          @default(now())

  flow Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runs FlowRun[]

  @@unique([flowId, version])
}

/// One person going through one flow version. Pinned to its version so a new
/// publish never changes a running conversation.
model FlowRun {
  id                 String        @id @default(cuid())
  workspaceId        String
  flowId             String
  versionId          String
  instagramAccountId String
  igUserId           String
  contactId          String?
  conversationId     String?
  // The InstagramEvent that started it.
  eventId            String
  // TriggerExecution of the proxy campaign: window anchor + thread ownership.
  executionId        String?       @unique
  status             FlowRunStatus @default(ACTIVE)
  currentNodeId      String?
  // Monotonic step counter, also the optimistic-concurrency token.
  seq                Int           @default(0)
  variables          Json          @default("{}")
  waitNodeId         String?
  waitUntil          DateTime?
  // "tap" | "inbound" | "phone" | "delay"
  waitKind           String?
  sendsSinceInbound  Int           @default(0)
  isTest             Boolean       @default(false)
  endReason          String?
  lastError          String?
  startedAt          DateTime      @default(now())
  finishedAt         DateTime?
  updatedAt          DateTime      @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow      Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version   FlowVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  steps     FlowRunStep[]

  @@index([instagramAccountId, igUserId, status])
  @@index([status, waitUntil])
  @@index([flowId, startedAt])
  @@index([workspaceId, startedAt])
}

model FlowRunStep {
  id         String         @id @default(cuid())
  runId      String
  seq        Int
  nodeId     String
  nodeType   String
  status     FlowStepStatus
  // Rendered text, evaluated condition inputs, payload sent.
  input      Json?
  // Branch taken, mid, variable written, http status.
  output     Json?
  reason     String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  run FlowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, startedAt])
}

/// User-saved templates; the five starters live in code (lib/flows/templates).
model FlowTemplate {
  id            String   @id @default(cuid())
  workspaceId   String?
  key           String   @unique
  name          String
  description   String?
  category      String
  locale        String   @default("uz")
  graph         Json
  schemaVersion Int      @default(1)
  sort          Int      @default(0)
  createdAt     DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// --- Integrations 2.0 outbound event bus (developer area, ETAP 8) ------------
// LeadDelivery keeps serving Telegram / amoCRM / Bitrix24 lead push; the bus
// serves the new connector types plus enrichment. See etap-8-integrations.md.

enum OutboundDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
  SKIPPED
}

model OutboundEvent {
  id                 String    @id @default(cuid())
  workspaceId        String
  type               String
  version            Int       @default(1)
  subjectType        String
  subjectId          String
  instagramAccountId String?
  isTest             Boolean   @default(false)
  // Frozen at materialisation; redeliveries reuse it.
  payload            Json?
  materializedAt     DateTime?
  dedupeKey          String
  occurredAt         DateTime
  createdAt          DateTime  @default(now())

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries OutboundDelivery[]

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, type, createdAt])
  @@index([materializedAt])
}

model OutboundDelivery {
  id              String                 @id @default(cuid())
  eventId         String
  integrationId   String
  subscriptionId  String?
  status          OutboundDeliveryStatus @default(PENDING)
  attempts        Int                    @default(0)
  nextAttemptAt   DateTime?
  lastError       String?
  responseCode    Int?
  // <= 300 chars, phones masked.
  responseSnippet String?
  signature       String?
  externalId      String?
  externalUrl     String?
  durationMs      Int?
  sentAt          DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  event       OutboundEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  integration Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([eventId, integrationId])
  @@index([status, nextAttemptAt])
  @@index([integrationId, status, createdAt])
}

model IntegrationSubscription {
  id            String   @id @default(cuid())
  integrationId String
  eventType     String
  // lib/integrations2/subscriptions.ts filter DSL
  filter        Json     @default("{}")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, eventType])
}

// --- Analytics rollups and alert state (developer area, ETAP 10) -------------

/// Pre-aggregated daily metric. Sums and counts only; rates are derived at
/// read time. Tashkent calendar day. Recomputing a day replaces its rows.
model AnalyticsDaily {
  id                 String   @id @default(cuid())
  workspaceId        String
  // "" = workspace-wide (no FK on purpose, avoids NULL in the unique key).
  instagramAccountId String   @default("")
  day                DateTime @db.Date
  metric             String
  // "" | automation | trigger_campaign | broadcast | reason | kind | pipeline | member
  dimKind            String   @default("")
  dimId              String   @default("")
  value              Decimal  @default(0) @db.Decimal(18, 6)
  computedAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, instagramAccountId, day, metric, dimKind, dimId])
  @@index([workspaceId, metric, day])
  @@index([workspaceId, day])
}

/// Cooldown bookkeeping for monitoring alerts (DB, not a Redis TTL, so a
/// Redis flush does not re-alert).
model AnalyticsAlertState {
  id            String   @id @default(cuid())
  workspaceId   String
  rule          String
  lastAlertedAt DateTime
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, rule])
}

// --- Engagement: Giveaway, Referral, Gamification (developer area, ETAP 9) ---
// New tables only. See docs/developer/etap-9-engagement.md.

enum GiveawayStatus {
  DRAFT
  ACTIVE
  CLOSED
  DRAWN
  ARCHIVED
}

enum GiveawayEntryStatus {
  ELIGIBLE
  INELIGIBLE
  PENDING_CHECK
  WINNER
  DISQUALIFIED
}

enum GiveawayDrawStatus {
  DRAWN
  CONFIRMED
  // Re-drawn after a disqualification; kept for the audit trail.
  VOIDED
}

enum FollowCheckResult {
  FOLLOWER
  NOT_FOLLOWER
  UNVERIFIABLE
  NOT_CHECKED
}

enum ReferralEventStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum ReferralQualifier {
  FIRST_MESSAGE
  LEAD
  PURCHASE
}

model Giveaway {
  id                 String         @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  name               String
  description        String?
  // The post. Permalink / caption cached in mediaMeta.
  mediaId            String
  mediaMeta          Json?
  // lib/engagement/giveaway/rules.ts (zod, versioned)
  rules              Json
  windowStart        DateTime
  windowEnd          DateTime
  status             GiveawayStatus @default(DRAFT)
  winnersCount       Int            @default(1)
  backupCount        Int            @default(0)
  // Commit-reveal: sha256(seed) is public before the draw.
  seedCommitment     String?
  seedEncrypted      String?
  committedAt        DateTime?
  // Optional Comment 2.0 campaign that sends the participation confirmation.
  confirmCampaignId  String?
  // Collector bookkeeping
  collectCursorAt    DateTime?
  collectCursorId    String?
  backfillStatus     String?
  backfillScanned    Int            @default(0)
  backfillError      String?
  entriesCount       Int            @default(0)
  eligibleCount      Int            @default(0)
  createdByUserId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount       @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  entries          GiveawayEntry[]
  draws            GiveawayDraw[]
  notifications    GiveawayNotification[]

  @@index([workspaceId, status])
  @@index([instagramAccountId, mediaId, status])
}

model GiveawayEntry {
  id               String              @id @default(cuid())
  giveawayId       String
  workspaceId      String
  igUserId         String
  username         String?
  contactId        String?
  firstCommentId   String
  firstCommentText String
  firstCommentAt   DateTime
  commentCount     Int                 @default(1)
  // InstagramEvent ids (empty for backfilled entries)
  sourceEventIds   String[]            @default([])
  mentionEventId   String?
  mentionedAt      DateTime?
  taggedUsernames  String[]            @default([])
  followResult     FollowCheckResult   @default(NOT_CHECKED)
  followCheckedAt  DateTime?
  // { ruleKey: { passed, detail, at } }
  checks           Json                @default("{}")
  status           GiveawayEntryStatus @default(PENDING_CHECK)
  ineligibleReason String?
  disqualifiedAt   DateTime?
  disqualifiedBy   String?
  disqualifyReason String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, igUserId])
  @@index([giveawayId, status])
  @@index([contactId])
}

model GiveawayDraw {
  id                String             @id @default(cuid())
  giveawayId        String
  workspaceId       String
  sequence          Int
  algorithm         String
  seedCommitment    String
  seedRevealed      String
  // sha256 of the sorted eligible igUserId list.
  entrantsHash      String
  entrantsCount     Int
  winnersCount      Int
  winnerEntryIds    String[]           @default([])
  backupEntryIds    String[]           @default([])
  // One line anyone can recompute.
  verification      String
  status            GiveawayDrawStatus @default(DRAWN)
  drawnAt           DateTime           @default(now())
  confirmedAt       DateTime?
  confirmedByUserId String?
  voidedAt          DateTime?
  voidReason        String?

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, sequence])
}

/// One winner-outreach attempt per channel.
model GiveawayNotification {
  id            String   @id @default(cuid())
  giveawayId    String
  entryId       String
  // DM | PUBLIC_REPLY | TELEGRAM
  channel       String
  // PENDING (claimed, sending) | SENT | SKIPPED | FAILED
  status        String
  reason        String?
  sentMessageId String?
  snapshot      Json?
  createdAt     DateTime @default(now())
  // A PENDING claim older than 10 minutes is "unknown" and never resent by itself.
  updatedAt     DateTime @updatedAt

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  // Claim-first idempotency: one row per winner and channel (Telegram: entryId "draw:<seq>").
  @@unique([giveawayId, entryId, channel])
}

model ReferralProgram {
  id                 String            @id @default(cuid())
  workspaceId        String
  instagramAccountId String            @unique
  name               String
  active             Boolean           @default(false)
  qualifier          ReferralQualifier @default(FIRST_MESSAGE)
  // { tagSlug?, points?, telegramOwner, dmTemplate?, refereeDmTemplate? }
  rewardRules        Json              @default("{}")
  burstLimitPerDay   Int               @default(10)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  codes            ReferralCode[]
  events           ReferralEvent[]

  @@index([workspaceId])
}

model ReferralCode {
  id                 String    @id @default(cuid())
  programId          String
  workspaceId        String
  instagramAccountId String
  contactId          String?
  // The referrer
  igUserId           String
  code               String
  createdAt          DateTime  @default(now())
  lastSharedAt       DateTime?

  program ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  events  ReferralEvent[]

  @@unique([instagramAccountId, code])
  @@unique([programId, igUserId])
}

model ReferralEvent {
  id                String              @id @default(cuid())
  programId         String
  workspaceId       String
  codeId            String
  referrerIgUserId  String
  referrerContactId String?
  refereeIgUserId   String
  refereeContactId  String?
  // The InstagramEvent that carried the ref.
  sourceEventId     String
  status            ReferralEventStatus @default(PENDING)
  qualifiedAt       DateTime?
  qualifiedBy       ReferralQualifier?
  rewardedAt        DateTime?
  rewardSnapshot    Json?
  // SELF_REFERRAL | SAME_PHONE | BURST | ALREADY_KNOWN_CONTACT
  fraudFlags        String[]            @default([])
  reviewedAt        DateTime?
  reviewedByUserId  String?
  rejectReason      String?
  createdAt         DateTime            @default(now())

  program ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  code    ReferralCode    @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([programId, refereeIgUserId])
  @@index([programId, status])
  @@index([referrerIgUserId, createdAt])
}

/// Points per reason and badge thresholds (defaults live in code).
model EngagementSettings {
  workspaceId String   @id
  pointsRules Json     @default("{}")
  badgeRules  Json     @default("[]")
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EngagementPoint {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  points      Int
  reason      String
  sourceTable String
  sourceId    String
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([sourceTable, sourceId, reason])
  @@index([workspaceId, contactId])
  @@index([workspaceId, occurredAt])
}

model EngagementBadge {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  badgeKey    String
  awardedAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([contactId, badgeKey])
  @@index([workspaceId])
}

// --- Migration from other platforms (developer area, ETAP 11) ----------------
// ManyChat exposes no flow content, so a project holds the automatic imports
// (tags, fields) and the per-flow conversion state. See etap-11-migration.md.

enum MigrationSource {
  MANYCHAT
}

enum MigrationStatus {
  CONNECTED
  ANALYZED
  IMPORTING
  DONE
  FAILED
}

enum MigrationItemKind {
  TAG
  CUSTOM_FIELD
  BOT_FIELD
  FLOW
  GROWTH_TOOL
}

enum MigrationItemStatus {
  PENDING
  MAPPED
  CONVERTED
  IMPORTED
  SKIPPED
  UNSUPPORTED
  FAILED
}

model MigrationProject {
  id                 String          @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  source             MigrationSource @default(MANYCHAT)
  name               String
  status             MigrationStatus @default(CONNECTED)
  // AES-GCM (lib/meta/oauth encryptToken); never serialized.
  apiKeyEncrypted    String?
  apiKeyHint         String?
  // Page name / id etc. as returned by the source.
  pageSnapshot       Json?
  lastAnalyzedAt     DateTime?
  lastError          String?
  createdByUserId    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     MigrationItem[]

  @@index([workspaceId, createdAt])
}

model MigrationItem {
  id              String              @id @default(cuid())
  projectId       String
  kind            MigrationItemKind
  // ManyChat id (flow ns, tag id, field id) when it has one.
  sourceId        String?
  name            String
  folder          String?
  status          MigrationItemStatus @default(PENDING)
  // Type / value / target (tag slug, customFields key, variable key...).
  mapping         Json                @default("{}")
  // Pasted flow text (never images); capped.
  sourceText      String?
  // [{ code, severity, message, feature? }]
  warnings        Json                @default("[]")
  // The SocialAuto flow created from this item.
  flowId          String?
  note            String?
  // Set while an import of this item is running (conditional claim, stale after minutes).
  importClaimedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, sourceId])
  @@index([projectId, kind, status])
}

// ─── MCP / AI control layer (ETAP 12), developer area ───────────────────────

enum McpScope {
  READ
  WRITE
}

enum McpActionStatus {
  PROPOSED
  CONFIRMED
  EXECUTED
  REJECTED
  EXPIRED
  FAILED
}

/// Bearer token an AI client (Claude / ChatGPT) uses at /api/mcp. Only the
/// sha256 hash is stored; the raw `sa_mcp_...` value is shown once on creation.
model McpToken {
  id                   String    @id @default(cuid())
  workspaceId          String
  name                 String
  tokenHash            String    @unique
  // Last 4 characters of the raw token, for the list.
  tokenHint            String
  scope                McpScope  @default(READ)
  // true (default): confirm_action over MCP is refused; a person approves in /developer/mcp.
  requireHumanApproval Boolean   @default(true)
  createdByUserId      String?
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  // Set when the token was issued by the OAuth flow (Claude.ai / Claude Desktop /
  // ChatGPT connectors); null = created by hand in /developer/mcp.
  oauthClientId        String?
  // sha256 of the OAuth refresh token; rotated on every refresh. Null for manual tokens.
  refreshTokenHash     String?   @unique
  refreshExpiresAt     DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions     McpAction[]
  oauthClient McpOAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

/// An MCP client registered through OAuth 2.1 dynamic client registration
/// (RFC 7591): Claude.ai, Claude Desktop, ChatGPT, Claude Code, ... Platform-wide
/// (registration happens before anyone is signed in); a client only ever gets a
/// token for the workspace whose owner approved it on the consent screen.
model McpOAuthClient {
  id                      String    @id @default(cuid())
  clientName              String
  redirectUris            String[]
  // "none" (public client + PKCE, the MCP default) or "client_secret_post".
  tokenEndpointAuthMethod String    @default("none")
  clientSecretHash        String?
  clientUri               String?
  createdAt               DateTime  @default(now())
  lastUsedAt              DateTime?

  tokens McpToken[]
  codes  McpAuthCode[]

  @@index([createdAt])
}

/// A one-time OAuth authorization code: the consent screen writes it, the
/// token endpoint burns it (atomically) and issues the McpToken.
model McpAuthCode {
  id                   String    @id @default(cuid())
  codeHash             String    @unique
  clientId             String
  redirectUri          String
  codeChallenge        String
  codeChallengeMethod  String    @default("S256")
  scope                McpScope  @default(READ)
  requireHumanApproval Boolean   @default(true)
  workspaceId          String
  userId               String
  resource             String?
  expiresAt            DateTime
  usedAt               DateTime?
  // The token issued from this code (so a replayed code can revoke it, RFC 6749 4.1.2).
  issuedTokenId        String?
  createdAt            DateTime  @default(now())

  client McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([expiresAt])
}

/// A write proposed over MCP: the audit log and the confirmation store. Nothing
/// runs until confirm_action moves PROPOSED -> CONFIRMED -> EXECUTED.
model McpAction {
  id              String          @id @default(cuid())
  workspaceId     String
  tokenId         String
  tool            String
  // The validated tool input (internal; never contains secrets).
  input           Json
  // What the person is shown before confirming.
  preview         Json
  status          McpActionStatus @default(PROPOSED)
  // sha256 of the one-time confirm code; cleared when the action is settled.
  confirmCodeHash String?
  expiresAt       DateTime
  result          Json?
  error           String?
  // Wrong confirm-code attempts; at 5 the action is REJECTED.
  failedAttempts  Int             @default(0)
  // Who approved it when a person did (developer:<userId>); null = confirmed over MCP.
  approvedBy      String?
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token     McpToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([tokenId, status])
}

// ─── Content Scheduler (developer area, ETAP 13) ──────────────────────────────
// Spec: docs/superpowers/specs/2026-10-22-content-scheduler-design.md §8.

enum PostType {
  FEED_IMAGE
  FEED_VIDEO
  CAROUSEL
  REEL
  TRIAL_REEL
  STORY
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PAUSED
  PREPARING
  READY_TO_PUBLISH
  PUBLISHING
  PUBLISHED
  NEEDS_MANUAL
  PUBLISHED_MANUAL
  FAILED
  REJECTED
  EXPIRED_REVIEW
  CANCELED
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ReviewRule {
  ANY
  ALL
  OPTIONAL
}

model MediaAsset {
  id           String      @id @default(cuid())
  workspaceId  String
  uploadedById String?
  // IMAGE | VIDEO
  kind         String
  // Bucket keys: the original upload, the Instagram-ready copy, the 640 px thumbnail.
  originalKey  String
  preparedKey  String?
  thumbKey     String?
  mimeType     String
  sizeBytes    BigInt
  // Size of the Instagram-ready copy (preparedKey); Instagram's limits apply to this, not the upload.
  preparedBytes Int?
  width        Int?
  height       Int?
  durationMs   Int?
  codec        String?
  fps          Float?
  status       MediaStatus @default(UPLOADING)
  error        String?
  tags         String[]    @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usages    ScheduledPostMedia[]

  @@index([workspaceId, createdAt])
  // Sweeper: abandoned UPLOADING rows (createdAt) and stalled PROCESSING rows (updatedAt).
  @@index([status, createdAt])
  @@index([status, updatedAt])
}

model ScheduledPost {
  id                 String      @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  createdById        String?
  type               PostType
  status             PostStatus  @default(DRAFT)
  // null for stories (the API has no caption there).
  caption            String?
  firstComment       String?
  collaborators      String[]    @default([])
  shareToFeed        Boolean     @default(true)
  coverMediaId       String?
  thumbOffsetMs      Int?
  // MANUAL | SS_PERFORMANCE (trial reels)
  trialStrategy      String?
  audioName          String?
  locationId         String?
  isAiGenerated      Boolean     @default(false)
  autoPublish        Boolean     @default(true)
  // STORY_STICKER | MUSIC | API_REJECTED | USER_CHOICE
  manualReason       String?
  // UTC
  scheduledAt        DateTime?
  timezone           String      @default("Asia/Tashkent")
  // Recurring series or a story series.
  seriesId           String?
  seriesIndex        Int?
  // Meta side
  containerId        String?
  containerStatus    String?
  containerCreatedAt DateTime?
  igMediaId          String?     @unique
  permalink          String?
  publishedAt        DateTime?
  firstCommentId     String?
  // SENT | FAILED | SKIPPED
  firstCommentStatus String?
  attempts           Int         @default(0)
  // lib/foundation/error-catalog code
  lastErrorCode      String?
  lastErrorMessage   String?
  // Approval (Faza 2)
  reviewRule         ReviewRule?
  reviewSubmittedAt  DateTime?
  labels             String[]    @default([])
  // Optimistic lock: every edit and status change bumps it.
  version            Int         @default(1)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  media            ScheduledPostMedia[]
  reviews          PostReview[]
  notes            PostNote[]
  attemptsLog      PublishAttempt[]
  automations      Automation[]
  triggerCampaigns TriggerCampaign[]

  @@index([status, scheduledAt])
  @@index([workspaceId, scheduledAt])
  @@index([instagramAccountId, scheduledAt])
  // Queue stats (groupBy status) and the review / failed lists.
  @@index([workspaceId, status])
  // Story series and recurrences: siblings of one post.
  @@index([seriesId])
}

model ScheduledPostMedia {
  id          String  @id @default(cuid())
  postId      String
  mediaId     String
  // Carousel order, from 0.
  position    Int
  altText     String?
  // [{ username, x?, y? }]
  userTags    Json    @default("[]")
  // { x, y, w, h } in 0..1
  cropRect    Json?
  // Carousel child container.
  containerId String?

  post  ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([postId, position])
  @@index([mediaId])
}

model PublishAttempt {
  id          String   @id @default(cuid())
  postId      String
  // CONTAINER | STATUS | PUBLISH | COMMENT | LINK_CAMPAIGN | MANUAL_NOTICE
  step        String
  ok          Boolean
  metaCode    Int?
  metaSubcode Int?
  fbTraceId   String?
  message     String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  post ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostReview {
  id             String    @id @default(cuid())
  postId         String
  reviewerUserId String?
  externalEmail  String?
  // SHA-256 of the external reviewer's link token.
  tokenHash      String?
  // APPROVED | REJECTED
  decision       String?
  comment        String?
  postVersion    Int
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  post ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  // The external reviewer's link is looked up by the hash of its token.
  @@index([tokenHash])
}

model PostNote {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model SavedText {
  id          String   @id @default(cuid())
  workspaceId String
  // ≤ 32
  title       String
  // ≤ 16 192
  body        String
  // "hashtags", "signature", ...
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model PostingSlot {
  id                 String    @id @default(cuid())
  instagramAccountId String
  // 0 = Monday
  weekday            Int
  // 0..1439 in the account's timezone
  minuteOfDay        Int
  postType           PostType?

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, weekday, minuteOfDay])
}

enum LegacyMigrationStatus {
  SHADOW
  CUTOVER
  ROLLED_BACK
}

/// Audit 2026-10-26 "legacy engine → one engine": an old Automation copied into
/// the Comment 2.0 engine. SHADOW = the copy exists switched off and every
/// comment on the account records whether both engines decide alike; CUTOVER =
/// copy on, Automation off (one transaction); ROLLED_BACK = the reverse.
model LegacyCampaignMigration {
  id                String                @id @default(cuid())
  workspaceId       String
  automationId      String                @unique
  /// The Comment 2.0 copy (plain id: the campaign may be deleted in the dev UI).
  triggerCampaignId String
  status            LegacyMigrationStatus @default(SHADOW)
  /// What the planner could not map 1:1 and the owner accepted (Uzbek notes).
  notes             String[]              @default([])
  shadowStartedAt   DateTime              @default(now())
  cutoverAt         DateTime?
  rolledBackAt      DateTime?
  /// Set when the owner switched over before the comparison was clean.
  forcedReason      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  samples    LegacyMigrationSample[]

  @@index([workspaceId, status])
}

/// One comment seen while a migration was in SHADOW: did the old engine match,
/// would the copy have matched. Unique per comment so the webhook + the
/// reconciler seeing the same comment count once.
model LegacyMigrationSample {
  id            String   @id @default(cuid())
  migrationId   String
  commentId     String
  commentText   String
  mediaId       String?
  legacyMatched Boolean
  newMatched    Boolean
  createdAt     DateTime @default(now())

  migration LegacyCampaignMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)

  @@unique([migrationId, commentId])
  @@index([migrationId, createdAt])
}

// --- Trust ladder (audit 2026-10-26: observe -> copilot -> auto per intent) ---

enum AiLadderMode {
  OBSERVE
  COPILOT
  AUTO
}

/// How JavobAI may answer one intent on one account. No row = OBSERVE.
model AiIntentPolicy {
  id                 String       @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  intent             String
  mode               AiLadderMode @default(OBSERVE)
  changedBy          String?
  changedAt          DateTime?
  /// Set when the engine pulled AUTO back to COPILOT (critical error, expired fact, complaints).
  demotedAt          DateTime?
  demoteReason       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, intent])
  @@index([workspaceId])
}

enum AiDraftStatus {
  PENDING
  SENT
  EDITED
  DISCARDED
  SUPERSEDED
  EXPIRED
  FAILED
}

/// COPILOT: a reply the AI prepared; a human sends it as is, edits it or throws it away.
model AiDraft {
  id                 String        @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  conversationId     String
  shadowTurnId       String?       @unique
  text               String
  intent             String?
  confidence         Float?
  status             AiDraftStatus @default(PENDING)
  finalText          String?
  decidedBy          String?
  decidedAt          DateTime?
  error              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([conversationId, status])
}

enum AiFactStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A fact the AI noticed in operator replies (or a manager added from Telegram).
/// Never used in an answer until the owner approves it into the knowledge base.
model AiFactCandidate {
  id               String          @id @default(cuid())
  workspaceId      String
  profileId        String
  kind             AiKnowledgeKind
  title            String
  body             String
  source           String          @default("observed")
  shadowTurnId     String?
  /// The operator sentence it came from.
  evidence         String?
  confidence       Float?
  status           AiFactStatus    @default(PENDING)
  validUntil       DateTime?
  knowledgeEntryId String?
  decidedBy        String?
  decidedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
}

/// "Golden" question of one account: every prompt / model change is re-run against these.
model AiEvalCase {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  question           String
  expectedIntent     String?
  /// Lower-cased fragments the answer must / must not contain (numbers, names).
  mustContain        String[] @default([])
  mustNotContain     String[] @default([])
  referenceAnswer    String?
  /// manual | observed (from a judged operator reply)
  source             String   @default("manual")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, active])
}

model AiEvalRun {
  id                 String    @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  model              String
  status             String    @default("RUNNING")
  total              Int       @default(0)
  passed             Int       @default(0)
  failed             Int       @default(0)
  /// [{ caseId, question, reply, intent, pass, reasons[] }]
  results            Json      @default("[]")
  triggeredBy        String?
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, startedAt])
}

/// Comment guard: an offensive comment hidden / a complaint flagged, once per comment.
model CommentModeration {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  commentId          String   @unique
  mediaId            String?
  text               String
  /// offensive | complaint | ok
  verdict            String
  /// hidden | notified | none | failed
  action             String
  error              String?
  createdAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
