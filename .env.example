# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialauto
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=SocialAuto <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: who can reach the cross-workspace /admin panel. Unset means
# nobody can, unlike ALLOWED_EMAILS which defaults open. Comma separated,
# case insensitive.
# ADMIN_EMAILS=you@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# ─── Lead assistant, Telegram and CRM integrations ────────────────────────────
# Platform Telegram bot (create with @BotFather). One bot serves lead delivery
# and the owner onboarding Q&A for every workspace.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=SocialAutoLeadsBot
# Random string. Registered with scripts/set-telegram-webhook.mjs; the webhook
# lives at /webhooks/telegram/<TELEGRAM_WEBHOOK_SECRET>.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# LLM provider for the assistant (anthropic | openai). Use a cheap, fast model:
# replies must come back in about 3 seconds.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=
# LLM_BASE_URL=            # only for OpenAI-compatible endpoints, e.g. http://localhost:11434/v1 for Ollama
# LLM_TIMEOUT_MS=12000     # raise for local models
# LLM_FALLBACK_MODELS=     # openai only: comma list tried in order when LLM_MODEL is overloaded (503/429)
# LLM_COST_INPUT_PER_M=    # USD per 1M tokens, for models not in the built-in price table
# LLM_COST_OUTPUT_PER_M=

# Speech-to-text for voice answers in the Telegram onboarding.
# STT_PROVIDER=openai
# STT_API_KEY=
# STT_MODEL=whisper-1

# Monthly AI-conversation quota per workspace (see Settings -> Usage). When it is
# used up the assistant keeps collecting phone numbers from fixed templates.
# AI_CONVERSATIONS_PER_MONTH=300
# Turn features off per deployment: {"integrations":false,"assistant":false}
# FEATURE_FLAGS={}
