# ---- App ----
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Fernet key for encrypting IG access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://igdm:igdm@postgres:5432/igdm

# ---- Redis / Queue ----
REDIS_URL=redis://redis:6379/0

# ---- Meta / Instagram App ----
# NOTE (see TZ section 7.3 / 10): permission scope names change often.
# Re-verify against https://developers.facebook.com/docs/instagram-platform before go-live.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me
META_GRAPH_API_VERSION=v21.0
# Must exactly match the frontend's NEXT_PUBLIC_META_OAUTH_REDIRECT_URI and the
# redirect URL registered under Instagram business login in the Meta dashboard.
# This is a frontend page (it receives Instagram's ?code=), not a backend route.
META_OAUTH_REDIRECT_URI=https://your-domain.example/accounts

# ---- Rate limiting ----
META_RATE_LIMIT_PER_ACCOUNT_PER_HOUR=180

# ---- Notifications (FR-10) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
DELIVERY_FAILURE_ALERT_THRESHOLD_PCT=20.0

# ---- Defaults ----
DEFAULT_COOLDOWN_HOURS=24
DEFAULT_GATE_MAX_RETRIES=3
DEFAULT_ABANDON_AFTER_DAYS=7
LOG_RETENTION_MONTHS=12
CORS_ORIGINS=http://localhost:3000

# ---- Frontend build args (docker-compose.prod.yml) ----
# Read by `docker compose -f docker-compose.prod.yml build`, baked into the
# Next.js bundle at build time -- changing these requires a rebuild, not just
# a container restart.
PUBLIC_API_URL=https://your-domain.example/api
NEXT_PUBLIC_META_APP_ID=
# Same value as META_OAUTH_REDIRECT_URI above.
NEXT_PUBLIC_META_OAUTH_REDIRECT_URI=https://your-domain.example/accounts
