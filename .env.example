# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialauto
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=SocialAuto <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: who can reach the cross-workspace /admin panel. Unset means
# nobody can, unlike ALLOWED_EMAILS which defaults open. Comma separated,
# case insensitive.
# ADMIN_EMAILS=you@example.com

# Platform admin panel (/admin/login). The first admin account is created from
# these on the first login attempt while the AdminAccount table is empty; with
# no ADMIN_INITIAL_PASSWORD (min 12 chars) nothing is seeded.
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_EMAIL=you@example.com
# ADMIN_INITIAL_PASSWORD=

# Optional: developer area (/developer) where unreleased modules are built and
# tested. Never linked from the product. One login: this email plus the scrypt
# hash of its password, printed by `node scripts/hash-developer-password.mjs`.
# Unset means the area is closed.
# DEVELOPER_EMAIL=you@example.com
# DEVELOPER_PASSWORD_HASH=

# Optional: Instagram Trigger Engine (developer area, /developer/triggers).
# TRIGGER_ENGINE_DISABLED=1 stops its webhook ingestion and worker.
# See lib/triggers/README.md.
# TRIGGER_ENGINE_DISABLED=1

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# ─── Lead assistant, Telegram and CRM integrations ────────────────────────────
# Platform Telegram bot (create with @BotFather). One bot serves lead delivery
# and the owner onboarding Q&A for every workspace.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=SocialAutoLeadsBot
# Random string. Registered with scripts/set-telegram-webhook.mjs; the webhook
# lives at /webhooks/telegram/<TELEGRAM_WEBHOOK_SECRET>.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# LLM provider for the assistant (anthropic | openai). Use a cheap, fast model:
# replies must come back in about 3 seconds.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=
# LLM_BASE_URL=            # only for OpenAI-compatible endpoints, e.g. http://localhost:11434/v1 for Ollama
# LLM_TIMEOUT_MS=12000     # raise for local models
# LLM_TOTAL_BUDGET_MS=25000 # overall deadline across primary + fallbacks + retries (a timeout is not retried on the same model)
# LLM_FALLBACK_MODELS=     # openai only: comma list tried in order when LLM_MODEL is overloaded (503/429)
# LLM_FALLBACK_PROVIDER=   # optional SECOND vendor (anthropic | openai) asked once when the primary chain failed
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=      # default claude-haiku-4-5-20251001 / gpt-4o-mini
# LLM_FALLBACK_BASE_URL=
# LLM_COST_INPUT_PER_M=    # USD per 1M tokens, for models not in the built-in price table
# LLM_COST_OUTPUT_PER_M=

# Speech-to-text for voice answers in the Telegram onboarding.
# STT_PROVIDER=openai
# STT_API_KEY=
# STT_MODEL=whisper-1

# Monthly AI-conversation quota per workspace (see Settings -> Usage). When it is
# used up the assistant keeps collecting phone numbers from fixed templates.
# AI_CONVERSATIONS_PER_MONTH=300
# Turn features off per deployment: {"integrations":false,"assistant":false}
# FEATURE_FLAGS={}

# CRM (developer area /developer/crm, ETAP 5) is OPT-IN: hooks, the "crm"
# worker, the 5-minute reconciler and broadcasts run only with CRM_ENABLED=1
# (set it for web and worker). CRM_DISABLED=1 is the kill switch and wins.
# CRM_ENABLED=1
# CRM_DISABLED=

# Analytics (developer area /developer/analytics, ETAP 10): daily rollups, KPI
# alerts and the "analytics" worker are ON by default; ANALYTICS_DISABLED=1 is the
# kill switch (stored rollups stay readable).
# ANALYTICS_DISABLED=

# Integrations 2.0 (developer area /developer/integrations, ETAP 8): the outbound
# event bus (Webhook / Google Sheets / Make / Zapier, Telegram HOT card, CRM
# enrichment) is ON by default; INTEGRATIONS_BUS_DISABLED=1 is the kill switch
# (emit, materialise and deliver stop; the Telegram / amoCRM / Bitrix24 lead
# pipeline is not affected).
# INTEGRATIONS_BUS_DISABLED=
# Webhook URL policy: comma-separated hosts ("example.com" exact, ".example.com"
# host + subdomains). ALLOW skips the port and private-address checks (staging),
# DENY wins over everything.
# OUTBOUND_WEBHOOK_ALLOW_HOSTS=
# OUTBOUND_WEBHOOK_DENY_HOSTS=

# Hourly outbound DM cap per Instagram account (default 200 — a BEHAVIOUR CHANGE from the
# old hard-coded 750). Set it explicitly: 750 keeps the previous production behaviour until the
# owner confirms Meta's current number. InstagramAccount.dmHourlyLimit overrides it per account.
# Sends over the cap wait for the next window and are given up (FAILED) after 24h (DMs) / 7 days
# (private replies to comments).
# DM_HOURLY_LIMIT_DEFAULT=200

# Engagement (developer area /developer/engagement, ETAP 9): giveaway collector,
# winner notifications and the "engagement" worker are ON by default;
# ENGAGEMENT_DISABLED=1 is the kill switch (nothing is collected or sent).
# ENGAGEMENT_DISABLED=

# Migration (developer area /developer/migration, ETAP 11): ManyChat assisted
# migration (read-only ManyChat API, AI flow conversion) is ON by default;
# MIGRATION_DISABLED=1 is the kill switch (connect / analyze / convert / import
# stop; reading and deleting a project, which wipes the stored key, still work).
# MIGRATION_DISABLED=

# MCP / AI control layer (developer area /developer/mcp, ETAP 12): POST /api/mcp
# (Model Context Protocol, bearer tokens created in /developer/mcp) is ON by default;
# MCP_DISABLED=1 is the kill switch (/api/mcp answers 503; listing and revoking tokens still work;
# the OAuth consent screen refuses new connections). OAuth discovery URLs are built from NEXTAUTH_URL.
# MCP_DISABLED=

# Content Scheduler (developer area /developer/content, ETAP 13): scheduled feed posts,
# carousels, Reels and Stories over the Instagram Content Publishing API, manual publishing
# over Telegram, post → comment-to-DM linking. ON by default; CONTENT_SCHEDULER_DISABLED=1 is
# the kill switch (API answers 404; the content-publish / media-process workers and the
# content-sweep cron stop). Set it for web AND worker.
# CONTENT_SCHEDULER_DISABLED=
# Media object storage. Any S3-compatible bucket (Cloudflare R2 recommended: endpoint
# https://<account>.r2.cloudflarestorage.com, region auto). The bucket stays private: the browser
# uploads with a presigned PUT (15 min), Meta fetches with a presigned GET (24 h). With no bucket
# the local filesystem driver is used (dev only — Meta cannot fetch from localhost).
# MEDIA_STORAGE_DRIVER=s3            # s3 | local (default: s3 when MEDIA_S3_BUCKET is set)
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=auto
# MEDIA_LOCAL_DIR=.media
# CONTENT_STORAGE_QUOTA_BYTES=5368709120   # per workspace, default 5 GB
# Meta's docs disagree on these; verify on the real account before raising.
# CAROUSEL_MAX_ITEMS=10               # 2..20
# IG_MAX_COLLABORATORS=3              # 1..5
# A post later than this many minutes (server down, token broken) is not published
# automatically: FAILED + "Vaqt o'tib ketdi — hozir chiqaraymi?".
# LATE_PUBLISH_MAX_MIN=15
# Media worker binaries (the Docker runner image installs ffmpeg).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Channel layer (audit 2026-10-26, phase 3; see lib/channels/README.md) ---
# Credential vault key-encryption keys: "<version>:<base64 of 32 random bytes>", comma separated.
# Without them a KEK derived from ENCRYPTION_KEY (version 0) is used. Rotate: add the new key,
# point CREDENTIAL_KEK_VERSION at it, run rewrapCredentials(), then remove the old key.
# CREDENTIAL_KEKS=1:base64key
# CREDENTIAL_KEK_VERSION=1
# Per-workspace cap on outbound channel API calls per hour (denial-of-wallet guard).
# CHANNEL_API_CALLS_PER_HOUR=3000
# Field-level overrides of lib/channels/capabilities.json, e.g. {"instagram":{"publish_daily_limit":100}}
# CHANNEL_CAPABILITIES_JSON=

# Facebook Page / Threads / YouTube adapters (audit phase 6, keys in phase 9).
# Pages/Messenger/Ads run in their own Meta app: FACEBOOK_APP_* above stays the
# Instagram app. Unset, these fall back to FACEBOOK_APP_ID / FACEBOOK_APP_SECRET.
# Page webhooks (signed with the channels secret) → <base>/webhooks/facebook.
# FACEBOOK_CHANNELS_APP_ID=
# FACEBOOK_CHANNELS_APP_SECRET=
# Facebook Login for Business configuration (without it the classic scope list is requested).
# FACEBOOK_LOGIN_CONFIG_ID=
# Threads app (its own id/secret); webhooks → <base>/webhooks/threads.
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# Google OAuth client for YouTube (redirect <base>/api/developer/channels/callback/youtube).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YouTube Data API daily project quota (units; an upload costs 1600).
# YOUTUBE_QUOTA_UNITS=10000

# Content intelligence (audit phase 5). Video analysis per workspace per month
# (default 30; tariff limits replace it in phase 8), Trial Reels per account per
# day (default 20), and a kill switch for the whole worker tick. Needs ffmpeg.
# CONTENT_ANALYSIS_MONTHLY_LIMIT=30
# TRIAL_REELS_DAILY_LIMIT=20
# CONTENT_INTEL_DISABLED=1

# Ads (audit phase 7). Facebook Login for Business configuration with
# ads_management / ads_read / business_management (else the scope list is requested).
# FACEBOOK_ADS_CONFIG_ID=
# Countries boosts target, comma separated ISO codes.
# ADS_DEFAULT_COUNTRIES=UZ
# Kill switch for the ads tick (guard, suggestions, CAPI).
# ADS_DISABLED=1

# Tariffs (audit phase 8). Limits are only shown until this is set; with it,
# over-limit actions answer 402 PLAN_LIMIT.
# BILLING_ENFORCED=1
# Override plan limits / so'm prices, e.g. {"biznes":{"aiReplies":1500}} and {"biznes":390000}.
# PLAN_LIMITS_JSON=
# PLAN_PRICES_UZS_JSON=
# USD_UZS_RATE=12700
# Payme Merchant API (endpoint /api/billing/payme). PAYME_TEST=1 uses checkout.test.paycom.uz.
# PAYME_ENABLED=1
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_TEST=1
# Click Shop API (endpoints /api/billing/click/prepare and /complete).
# CLICK_ENABLED=1
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
